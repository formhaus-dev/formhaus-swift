{
  "name": "single-step",
  "definition": {
    "id": "contact",
    "title": "Contact",
    "description": "We reply within two working days.",
    "submit": {
      "label": "Submit"
    },
    "fields": [
      {
        "key": "name",
        "type": "text",
        "label": "Name",
        "validation": {
          "required": true,
          "minLength": 2
        }
      },
      {
        "key": "email",
        "type": "email",
        "label": "Email",
        "validation": {
          "required": true
        }
      },
      {
        "key": "age",
        "type": "number",
        "label": "Age",
        "validation": {
          "min": 18
        }
      },
      {
        "key": "subscribe",
        "type": "checkbox",
        "label": "Subscribe"
      }
    ]
  },
  "cases": [
    {
      "name": "accepts a valid payload and parses a numeric string",
      "input": {
        "values": {
          "name": "Ada",
          "email": "ada@example.com",
          "age": "42",
          "subscribe": true
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "name": "Ada",
          "email": "ada@example.com",
          "age": 42,
          "subscribe": true
        },
        "errors": {}
      }
    },
    {
      "name": "reports rule errors",
      "input": {
        "values": {
          "name": "A",
          "age": 12,
          "subscribe": false
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "name": "A",
          "age": 12,
          "subscribe": false
        },
        "errors": {
          "name": "Minimum length is 2",
          "email": "This field is required",
          "age": "Must be at least 18"
        }
      }
    },
    {
      "name": "rejects an invalid email and a non-numeric number",
      "input": {
        "values": {
          "name": "Ada",
          "email": "not-an-email",
          "age": "12abc"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": { "name": "Ada" },
        "errors": {
          "email": "Enter a valid email",
          "age": "Enter a number"
        }
      }
    },
    {
      "name": "accepts decimal and exponent number strings",
      "input": {
        "values": {
          "name": "Ada",
          "email": "ada@example.com",
          "age": "1e3"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "name": "Ada",
          "email": "ada@example.com",
          "age": 1000
        },
        "errors": {}
      }
    },
    {
      "name": "rejects hex number strings",
      "input": {
        "values": {
          "name": "Ada",
          "email": "ada@example.com",
          "age": "0x10"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": { "name": "Ada", "email": "ada@example.com" },
        "errors": {
          "age": "Enter a number"
        }
      }
    },
    {
      "name": "rejects padded and infinite number strings",
      "input": {
        "values": {
          "name": "Ada",
          "email": "ada@example.com",
          "age": " 42"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": { "name": "Ada", "email": "ada@example.com" },
        "errors": {
          "age": "Enter a number"
        }
      }
    },
    {
      "name": "rejects numbers that overflow",
      "input": {
        "values": {
          "name": "Ada",
          "email": "ada@example.com",
          "age": "1e999"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": { "name": "Ada", "email": "ada@example.com" },
        "errors": {
          "age": "Enter a number"
        }
      }
    },
    {
      "name": "type error replaces the rule error",
      "input": {
        "values": {
          "name": 5,
          "email": "ada@example.com"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": { "email": "ada@example.com" },
        "errors": {
          "name": "Must be text"
        }
      }
    },
    {
      "name": "null and an empty array are blank",
      "input": {
        "values": {
          "name": null,
          "email": []
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "name": null
        },
        "errors": {
          "name": "This field is required",
          "email": "This field is required"
        }
      }
    },
    {
      "name": "rejects an email longer than 254 characters",
      "input": {
        "values": {
          "name": "Ada",
          "email": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@b.co"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": { "name": "Ada" },
        "errors": {
          "email": "Enter a valid email"
        }
      }
    },
    {
      "name": "rejects an email without a dot in the domain",
      "input": {
        "values": {
          "name": "Ada",
          "email": "ada@example"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": { "name": "Ada" },
        "errors": {
          "email": "Enter a valid email"
        }
      }
    },
    {
      "name": "rejects strings longer than 10000 characters",
      "input": {
        "values": {
          "name": "",
          "email": "ada@example.com"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": { "email": "ada@example.com" },
        "errors": {
          "name": "Maximum length is 10000"
        }
      }
    }
  ]
}
