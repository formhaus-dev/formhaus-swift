{
  "name": "file-multiple",
  "definition": {
    "formatVersion": "1.7",
    "id": "attachments",
    "title": "Attachments",
    "submit": {
      "label": "Send"
    },
    "fields": [
      {
        "key": "docs",
        "type": "file",
        "label": "Documents",
        "multiple": true
      }
    ]
  },
  "cases": [
    {
      "name": "accepts a list of references",
      "input": {
        "values": {
          "docs": ["upload-1", "upload-2"]
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "docs": ["upload-1", "upload-2"]
        },
        "errors": {}
      }
    },
    {
      "name": "reads a single reference as a list of one",
      "input": {
        "values": {
          "docs": "upload-1"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "docs": ["upload-1"]
        },
        "errors": {}
      }
    },
    {
      "name": "keeps an empty list",
      "input": {
        "values": {
          "docs": []
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "docs": []
        },
        "errors": {}
      }
    },
    {
      "name": "drops a list with an item that is not a string",
      "input": {
        "values": {
          "docs": ["upload-1", 5]
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {},
        "errors": {
          "docs": "Must be a file reference"
        }
      }
    },
    {
      "name": "drops empty entries from a list",
      "input": {
        "values": {
          "docs": ["upload-1", "", null]
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "docs": ["upload-1"]
        },
        "errors": {}
      }
    },
    {
      "name": "drops an object",
      "input": {
        "values": {
          "docs": {
            "id": "upload-1"
          }
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {},
        "errors": {
          "docs": "Must be a file reference"
        }
      }
    },
    {
      "name": "drops a list with an object without a name",
      "input": {
        "values": {
          "docs": [
            "upload-1",
            {
              "id": "upload-2"
            }
          ]
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {},
        "errors": {
          "docs": "Must be a file reference"
        }
      }
    }
  ]
}
