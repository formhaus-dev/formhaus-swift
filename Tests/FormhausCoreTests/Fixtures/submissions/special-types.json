{
  "name": "special-types",
  "definition": {
    "id": "special",
    "title": "Special types",
    "submit": {
      "label": "Submit"
    },
    "fields": [
      {
        "key": "avatar",
        "type": "file",
        "label": "Avatar"
      },
      {
        "key": "birthday",
        "type": "date",
        "label": "Birthday"
      },
      {
        "key": "meeting",
        "type": "datetime",
        "label": "Meeting"
      },
      {
        "key": "rating",
        "type": "x-rating",
        "label": "Rating"
      },
      {
        "key": "color",
        "type": "color-picker",
        "label": "Color"
      }
    ]
  },
  "cases": [
    {
      "name": "accepts a file reference, ISO dates and primitive custom values",
      "input": {
        "values": {
          "avatar": "uploads/a.png",
          "birthday": "1990-04-12",
          "meeting": "2026-10-10T14:30",
          "rating": 4,
          "color": "#ff0000"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "avatar": "uploads/a.png",
          "birthday": "1990-04-12",
          "meeting": "2026-10-10T14:30",
          "rating": 4,
          "color": "#ff0000"
        },
        "errors": {}
      }
    },
    {
      "name": "accepts datetime seconds, fractions and offsets",
      "input": {
        "values": {
          "meeting": "2026-10-10T14:30:15.250+02:00",
          "rating": true,
          "color": "red"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "meeting": "2026-10-10T14:30:15.250+02:00",
          "rating": true,
          "color": "red"
        },
        "errors": {}
      }
    },
    {
      "name": "accepts a UTC datetime",
      "input": {
        "values": {
          "meeting": "2026-10-10T14:30:15Z"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "meeting": "2026-10-10T14:30:15Z"
        },
        "errors": {}
      }
    },
    {
      "name": "rejects wrong shapes",
      "input": {
        "values": {
          "avatar": {},
          "birthday": "12/04/1990",
          "meeting": "2026-10-10 14:30",
          "rating": {
            "$gt": 0
          },
          "color": [1]
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {},
        "errors": {
          "avatar": "Must be a file reference",
          "birthday": "Enter a valid date",
          "meeting": "Enter a valid date and time",
          "rating": "Invalid value",
          "color": "Invalid value"
        }
      }
    },
    {
      "name": "rejects out-of-range dates and over-length custom strings",
      "input": {
        "values": {
          "avatar": 42,
          "birthday": "1990-13-01",
          "meeting": "2026-10-10T24:00",
          "rating": ""
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {},
        "errors": {
          "avatar": "Must be a file reference",
          "birthday": "Enter a valid date",
          "meeting": "Enter a valid date and time",
          "rating": "Maximum length is 10000"
        }
      }
    }
  ]
}
