{
  "name": "routes",
  "definition": {
    "id": "routed",
    "title": "Routed",
    "submit": {
      "label": "Submit"
    },
    "steps": [
      {
        "id": "kind",
        "title": "Kind",
        "routes": [
          {
            "to": "business",
            "show": [
              {
                "field": "kind",
                "eq": "business"
              }
            ]
          },
          {
            "to": "personal"
          }
        ],
        "fields": [
          {
            "key": "kind",
            "type": "select",
            "label": "Kind",
            "options": [
              {
                "value": "business",
                "label": "Business"
              },
              {
                "value": "personal",
                "label": "Personal"
              }
            ],
            "validation": {
              "required": true
            }
          }
        ]
      },
      {
        "id": "business",
        "title": "Business",
        "routes": [
          {
            "to": "contact"
          }
        ],
        "fields": [
          {
            "key": "companyName",
            "type": "text",
            "label": "Company",
            "validation": {
              "required": true
            }
          }
        ]
      },
      {
        "id": "personal",
        "title": "Personal",
        "fields": [
          {
            "key": "firstName",
            "type": "text",
            "label": "First name",
            "validation": {
              "required": true
            }
          }
        ]
      },
      {
        "id": "contact",
        "title": "Contact",
        "fields": [
          {
            "key": "phone",
            "type": "phone",
            "label": "Phone",
            "validation": {
              "required": true
            }
          }
        ]
      }
    ]
  },
  "cases": [
    {
      "name": "drops values off the business route",
      "input": {
        "values": {
          "kind": "business",
          "companyName": "Acme",
          "firstName": "Ada",
          "phone": "+100"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "kind": "business",
          "companyName": "Acme",
          "phone": "+100"
        },
        "errors": {}
      }
    },
    {
      "name": "validates the personal route",
      "input": {
        "values": {
          "kind": "personal",
          "companyName": "Acme"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "kind": "personal"
        },
        "errors": {
          "firstName": "This field is required",
          "phone": "This field is required"
        }
      }
    }
  ]
}
