{
  "name": "file-multiple",
  "issues": [],
  "warnings": [],
  "definition": {
    "formatVersion": "1.7",
    "id": "attachments",
    "title": "Attachments",
    "submit": {
      "label": "Send"
    },
    "fields": [
      {
        "key": "docs",
        "type": "file",
        "label": "Documents",
        "multiple": true,
        "accept": ".pdf",
        "validation": {
          "required": true,
          "maxLength": 3
        }
      },
      {
        "key": "photos",
        "type": "file",
        "label": "Photos",
        "helperText": "You sent {{docs}}",
        "multiple": true,
        "validation": {
          "minLength": 2
        }
      },
      {
        "key": "cover",
        "type": "file",
        "label": "Cover letter"
      }
    ]
  },
  "cases": [
    {
      "name": "a list of references",
      "input": {
        "values": {
          "docs": ["upload-1", "upload-2"],
          "cover": "upload-3"
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "docs": ["upload-1", "upload-2"],
          "cover": "upload-3"
        },
        "errors": {}
      },
      "canSubmit": true
    },
    {
      "name": "an empty list is empty for required",
      "input": {
        "values": {
          "docs": []
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "docs": []
        },
        "errors": {
          "docs": "This field is required"
        }
      },
      "canSubmit": false
    },
    {
      "name": "null is empty for required",
      "input": {
        "values": {
          "docs": null
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "docs": null
        },
        "errors": {
          "docs": "This field is required"
        }
      },
      "canSubmit": false
    },
    {
      "name": "maxLength counts the files",
      "input": {
        "values": {
          "docs": ["a", "b", "c", "d"]
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "docs": ["a", "b", "c", "d"]
        },
        "errors": {
          "docs": "At most 3 allowed"
        }
      },
      "canSubmit": false,
      "serverValues": {}
    },
    {
      "name": "minLength counts the files",
      "input": {
        "values": {
          "docs": ["a"],
          "photos": ["b"]
        },
        "skippedSteps": []
      },
      "expected": {
        "values": {
          "docs": ["a"],
          "photos": ["b"]
