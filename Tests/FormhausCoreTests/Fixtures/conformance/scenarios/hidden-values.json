    {
      "name": "leaves answers off the active path out of the payload by default",
      "definition": {
        "formatVersion": "1.4",
        "id": "trip",
        "title": "Trip",
        "submit": {
          "label": "Book"
        },
        "steps": [
          {
            "id": "mode",
            "title": "Mode",
            "fields": [
              {
                "key": "mode",
                "type": "radio",
                "label": "Mode",
                "options": [
                  {
                    "value": "train",
                    "label": "Train"
                  },
                  {
                    "value": "car",
                    "label": "Car"
                  }
                ]
              }
            ],
            "routes": [
              {
                "to": "car",
                "show": [
                  {
                    "field": "mode",
                    "eq": "car"
                  }
                ]
              }
            ]
          },
          {
            "id": "train",
            "title": "Train",
            "fields": [
              {
                "key": "seat",
                "type": "text",
                "label": "Seat"
              }
            ]
          },
          {
            "id": "car",
            "title": "Car",
            "fields": [
              {
                "key": "plate",
                "type": "text",
                "label": "Plate"
              }
            ]
          }
        ]
      },
      "values": {
        "mode": "car",
        "seat": "12A",
        "plate": "XY 123"
      },
      "steps": [
        {
          "expect": {
            "steps": ["mode", "car"],
            "values": {
              "mode": "car",
              "seat": "12A",
              "plate": "XY 123"
            },
            "submitValues": {
              "mode": "car",
              "plate": "XY 123"
            }
          }
        }
      ]
    },
    {
      "name": "sends answers off the active path",
