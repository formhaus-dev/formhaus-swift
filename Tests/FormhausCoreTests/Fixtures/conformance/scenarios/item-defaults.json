    {
      "name": "keeps the value of the active step when the other step is hidden - flag toggled",
      "definition": {
        "id": "exclusive",
        "title": "exclusive",
        "submit": {
          "label": "Send"
        },
        "steps": [
          {
            "id": "start",
            "title": "Start",
            "fields": [
              {
                "key": "flag",
                "type": "checkbox",
                "label": "Flag",
                "defaultValue": true
              }
            ],
            "routes": [
              {
                "to": "b",
                "show": [
                  {
                    "field": "flag",
                    "eq": false
                  }
                ]
              }
            ]
          },
          {
            "id": "a",
            "title": "A",
            "show": [
              {
                "field": "flag",
                "eq": true
              }
            ],
            "fields": [
              {
                "key": "x",
                "type": "text",
                "label": "X",
                "defaultValue": "saved"
              }
            ],
            "routes": [
              {
                "to": null,
                "show": [
                  {
                    "field": "x",
                    "eq": "saved"
                  }
                ]
              },
              {
                "to": null
              }
            ]
          },
          {
            "id": "b",
            "title": "B",
            "show": [
              {
                "field": "flag",
                "eq": false
              }
            ],
            "fields": [
              {
                "key": "x",
                "type": "text",
                "label": "X"
              }
            ]
          }
        ]
      },
      "steps": [
        {
          "expect": {
            "values": {
              "flag": true,
              "x": "saved"
            }
          }
        },
        {
          "do": "setValue",
          "key": "flag",
          "value": false
        },
        {
          "do": "setValue",
          "key": "x",
          "value": "typed"
        },
        {
          "do": "setValue",
          "key": "flag",
          "value": true
        },
