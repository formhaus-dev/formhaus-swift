{
  "$schema": "./scenario.schema.json",
  "name": "item defaults",
  "definition": {
    "id": "crew",
    "title": "crew",
    "submit": {
      "label": "Send"
    },
    "fields": [
      {
        "key": "crew",
        "type": "group",
        "label": "Crew",
        "fields": [
          {
            "key": "kind",
            "type": "select",
            "label": "Kind",
            "options": [
              {
                "value": "x",
                "label": "x"
              },
              {
                "value": "y",
                "label": "y"
              }
            ]
          },
          {
            "key": "count",
            "type": "number",
            "label": "Count",
            "defaultValue": 1,
            "show": [
              {
                "field": "kind",
                "eq": "x"
              }
            ]
          }
        ]
      }
    ]
  },
  "scenarios": [
    {
      "name": "gives an item field its default when its item condition matches",
      "steps": [
        {
          "do": "addItem",
          "key": "crew",
          "returns": true
        },
        {
          "expect": {
            "values": {
              "crew": [{}]
            }
          }
        },
        {
          "do": "setValue",
          "key": "crew.0.kind",
          "value": "x"
        },
        {
          "expect": {
            "values": {
              "crew": [
                {
                  "kind": "x",
                  "count": 1
                }
              ]
            }
          }
        },
        {
          "do": "setValue",
          "key": "crew.0.kind",
          "value": "y"
        },
        {
          "do": "setValue",
          "key": "crew.0.kind",
          "value": "x"
        },
        {
          "expect": {
            "values": {
              "crew": [
                {
                  "kind": "x",
                  "count": 1
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "gives an item field its last value when its item condition matches again",
      "values": {
        "crew": [
          {
            "kind": "x",
            "count": 2
          }
        ]
      },
      "steps": [
        {
          "do": "setValue",
          "key": "crew.0.count",
          "value": 5
        },
        {
          "do": "setValue",
          "key": "crew.0.kind",
          "value": "y"
        },
        {
          "expect": {
            "values": {
              "crew": [
                {
                  "kind": "y"
                }
              ]
            }
          }
        },
        {
          "do": "setValue",
          "key": "crew.0.kind",
          "value": "x"
        },
        {
          "expect": {
            "values": {
              "crew": [
                {
                  "kind": "x",
                  "count": 5
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "remembers item values by item, not by position",
      "values": {
        "crew": [
          {
            "kind": "x",
            "count": 2
          },
          {
            "kind": "x",
            "count": 3
          }
        ]
      },
      "steps": [
        {
          "do": "setValue",
          "key": "crew.0.count",
          "value": 5
        },
        {
          "do": "removeItem",
          "key": "crew",
          "index": 0,
          "returns": true
        },
        {
          "do": "setValue",
          "key": "crew.0.kind",
          "value": "y"
        },
        {
          "do": "setValue",
          "key": "crew.0.kind",
          "value": "x"
        },
        {
          "expect": {
            "values": {
              "crew": [
                {
                  "kind": "x",
                  "count": 3
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "gives item fields of initial items their defaults like top-level fields - top-level default",
      "definition": {
        "id": "crew",
        "title": "crew",
        "submit": {
          "label": "Send"
        },
        "fields": [
          {
            "key": "on",
            "type": "checkbox",
            "label": "On"
          },
          {
            "key": "partySize",
            "type": "number",
            "label": "Party",
            "defaultValue": 1,
            "show": [
              {
                "field": "on",
                "eq": true
              }
            ]
          },
          {
            "key": "crew",
            "type": "group",
            "label": "Crew",
            "fields": [
              {
                "key": "kind",
                "type": "text",
                "label": "Kind"
              },
              {
                "key": "count",
                "type": "number",
                "label": "Count",
                "defaultValue": 1,
                "show": [
                  {
                    "field": "kind",
                    "eq": "x"
                  }
                ]
              }
            ]
          }
        ]
      },
      "values": {
        "on": false,
        "crew": [
          {
            "kind": "y"
          }
        ]
      },
      "steps": [
        {
          "do": "setValue",
          "key": "on",
          "value": true
        },
        {
          "expect": {
            "values": {
              "on": true,
              "partySize": 1,
              "crew": [
                {
                  "kind": "y"
                }
              ]
            }
          }
        },
        {
          "do": "setValue",
          "key": "crew.0.kind",
          "value": "x"
        },
        {
          "expect": {
            "values": {
              "on": true,
              "partySize": 1,
              "crew": [
                {
                  "kind": "x",
                  "count": 1
                }
              ]
            }
          }
        }
      ]
    },
