    {
      "name": "clears a hidden group and its item errors",
      "definition": {
        "id": "event",
        "title": "event",
        "submit": {
          "label": "Send"
        },
        "formatVersion": "1.1",
        "fields": [
          {
            "key": "company",
            "type": "checkbox",
            "label": "Company"
          },
          {
            "key": "people",
            "type": "group",
            "label": "People",
            "itemLabel": "Person {index}",
            "defaultItems": 1,
            "validation": {
              "required": true,
              "maxLength": 3
            },
            "fields": [
              {
                "key": "name",
                "type": "text",
                "label": "Name",
                "validation": {
                  "required": true
                }
              },
              {
                "key": "email",
                "type": "email",
                "label": "Email"
              },
              {
                "key": "confirm",
                "type": "email",
                "label": "Confirm",
                "validation": {
                  "matchField": "email"
                }
              },
              {
                "key": "diet",
                "type": "select",
                "label": "Diet",
                "defaultValue": "none",
                "options": [
                  {
                    "value": "none",
                    "label": "none"
                  },
                  {
                    "value": "other",
                    "label": "other"
                  }
                ]
              },
              {
                "key": "dietNote",
                "type": "text",
                "label": "Details",
                "show": [
                  {
                    "field": "diet",
                    "eq": "other"
                  }
                ],
                "validation": {
                  "required": true
                }
              }
            ],
            "show": [
              {
                "field": "company",
                "eq": true
              }
            ]
          }
        ]
      },
      "values": {
        "company": true,
        "people": [{}]
      },
      "steps": [
        {
          "do": "validate"
        },
        {
          "expect": {
            "errors": {
              "people.0.name": "This field is required"
            }
          }
        },
        {
          "do": "setValue",
          "key": "company",
          "value": false
        },
        {
          "expect": {
            "values": {
              "company": false
            },
            "errors": {},
            "items": {
              "people": 0
            }
          }
        }
      ]
    },
    {
      "name": "maps server errors to items and keeps them until the item field changes",
      "values": {
        "people": [
          {
            "name": "A"
          },
          {
            "name": "B"
          }
        ]
      },
      "steps": [
        {
          "do": "submit",
          "handler": [
            {
              "return": {
                "ok": false,
                "errors": {
                  "people.1.name": "Taken",
                  "people.7.name": "Gone",
                  "people": "Too many"
                }
              }
            }
          ]
        },
        {
          "expect": {
            "errors": {
              "people.1.name": "Taken",
              "people": "Too many"
            },
            "topLevelErrors": ["Gone"]
          }
        },
        {
          "do": "setItemValue",
          "key": "people",
          "index": 0,
          "field": "name",
          "value": "A2"
        },
        {
          "expect": {
            "errors": {
              "people.1.name": "Taken",
              "people": "Too many"
            }
          }
        },
        {
          "do": "removeItem",
          "key": "people",
          "index": 0,
          "returns": true
        },
        {
          "expect": {
            "errors": {
              "people.0.name": "Taken"
            }
          }
        },
        {
          "do": "setValue",
          "key": "people.0.name",
          "value": "C"
        },
        {
          "expect": {
            "errors": {}
          }
        }
      ]
    },
    {
      "name": "accepts paths in setErrors and opens the step with the item error",
      "definition": {
        "id": "wizard",
        "title": "wizard",
        "submit": {
