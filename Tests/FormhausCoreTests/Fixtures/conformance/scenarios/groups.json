{
  "$schema": "./scenario.schema.json",
  "name": "groups",
  "definition": {
    "id": "event",
    "title": "event",
    "submit": {
      "label": "Send"
    },
    "formatVersion": "1.1",
    "fields": [
      {
        "key": "company",
        "type": "checkbox",
        "label": "Company"
      },
      {
        "key": "billing",
        "type": "section",
        "title": "Billing",
        "show": [
          {
            "field": "company",
            "eq": true
          }
        ],
        "fields": [
          {
            "key": "street",
            "type": "text",
            "label": "Street",
            "validation": {
              "required": true
            }
          }
        ]
      },
      {
        "key": "people",
        "type": "group",
        "label": "People",
        "itemLabel": "Person {index}",
        "defaultItems": 1,
        "validation": {
          "required": true,
          "maxLength": 3
        },
        "fields": [
          {
            "key": "name",
            "type": "text",
            "label": "Name",
            "validation": {
              "required": true
            }
          },
          {
            "key": "email",
            "type": "email",
            "label": "Email"
          },
          {
            "key": "confirm",
            "type": "email",
            "label": "Confirm",
            "validation": {
              "matchField": "email"
            }
          },
          {
            "key": "diet",
            "type": "select",
            "label": "Diet",
            "defaultValue": "none",
            "options": [
              {
                "value": "none",
                "label": "none"
              },
              {
                "value": "other",
                "label": "other"
              }
            ]
          },
          {
            "key": "dietNote",
            "type": "text",
            "label": "Details",
            "show": [
              {
                "field": "diet",
                "eq": "other"
              }
            ],
            "validation": {
              "required": true
            }
          },
          {
            "key": "vat",
            "type": "text",
            "label": "VAT",
            "show": [
              {
                "field": "company",
                "eq": true
              }
            ]
          }
        ]
      },
      {
        "key": "summary",
        "type": "text",
        "label": "Summary",
        "show": [
          {
            "field": "people",
            "notEmpty": true
          }
        ]
      }
    ]
  },
  "scenarios": [
    {
      "name": "adds and removes items within the limits",
      "steps": [
        {
          "do": "removeItem",
          "key": "people",
          "index": 0,
          "returns": false
        },
        {
          "do": "addItem",
          "key": "people",
          "returns": true
        },
        {
          "do": "addItem",
          "key": "people",
          "returns": true
        },
        {
          "do": "addItem",
          "key": "people",
          "returns": false
        },
        {
          "expect": {
            "items": {
              "people": 3
            },
            "values": {
              "people": [
                {
                  "diet": "none"
                },
                {
                  "diet": "none"
                },
                {
                  "diet": "none"
                }
              ]
            }
          }
        },
        {
          "do": "removeItem",
          "key": "people",
          "index": 5,
          "returns": false
        },
        {
          "do": "removeItem",
          "key": "people",
          "index": 1,
          "returns": true
        },
        {
          "expect": {
            "items": {
              "people": 2
            },
            "values": {
              "people": [
                {
                  "diet": "none"
                },
                {
                  "diet": "none"
                }
              ]
            }
          }
        },
        {
          "do": "addItem",
          "key": "missing",
          "returns": false
        }
      ]
    },
    {
      "name": "validates every item and reports errors by path",
      "values": {
        "people": [
          {
            "name": "Ada",
            "email": "a@x.io",
            "confirm": "b@x.io"
          },
          {
            "diet": "other"
          }
        ]
      },
      "steps": [
        {
          "do": "validate",
          "returns": {
            "people.0.confirm": "Fields must match",
            "people.1.name": "This field is required",
            "people.1.dietNote": "This field is required"
          }
        },
        {
          "do": "setValue",
          "key": "people.0.email",
          "value": "b@x.io"
        },
        {
          "expect": {
            "errors": {
              "people.1.name": "This field is required",
              "people.1.dietNote": "This field is required"
            }
          }
        },
        {
          "do": "validateField",
          "key": "people.1.name",
          "returns": "This field is required"
        },
        {
          "do": "validateField",
          "key": "people.1.vat",
          "returns": null
        }
      ]
    },
    {
      "name": "reports count rules under the group key - minLength",
      "definition": {
        "id": "event",
        "title": "event",
        "submit": {
          "label": "Send"
        },
        "formatVersion": "1.1",
        "fields": [
          {
            "key": "people",
            "type": "group",
            "label": "People",
            "itemLabel": "Person {index}",
            "defaultItems": 0,
            "validation": {
              "minLength": 2,
              "maxLength": 3
            },
            "fields": [
              {
                "key": "name",
                "type": "text",
                "label": "Name",
                "validation": {
                  "required": true
                }
              },
              {
                "key": "email",
                "type": "email",
                "label": "Email"
              },
              {
                "key": "confirm",
                "type": "email",
                "label": "Confirm",
                "validation": {
                  "matchField": "email"
                }
              },
              {
                "key": "diet",
                "type": "select",
                "label": "Diet",
                "defaultValue": "none",
                "options": [
                  {
                    "value": "none",
                    "label": "none"
                  },
                  {
                    "value": "other",
                    "label": "other"
                  }
                ]
              },
              {
                "key": "dietNote",
                "type": "text",
                "label": "Details",
                "show": [
                  {
                    "field": "diet",
                    "eq": "other"
                  }
                ],
                "validation": {
                  "required": true
                }
              }
            ]
          }
        ]
      },
      "values": {
        "people": [
          {
            "name": "A"
          }
        ]
      },
      "steps": [
        {
          "do": "validate",
          "returns": {
            "people": "Must be at least 2 items"
          }
        }
      ]
    },
