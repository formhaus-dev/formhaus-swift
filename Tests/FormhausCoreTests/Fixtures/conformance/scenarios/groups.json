                "key": "title",
                "type": "text",
                "label": "Title"
              }
            ]
          },
          {
            "id": "two",
            "title": "Two",
            "skip": {
              "label": "Skip"
            },
            "fields": [
              {
                "key": "people",
                "type": "group",
                "label": "People",
                "itemLabel": "Person {index}",
                "defaultItems": 2,
                "validation": {
                  "required": true,
                  "maxLength": 3
                },
                "fields": [
                  {
                    "key": "name",
                    "type": "text",
                    "label": "Name",
                    "validation": {
                      "required": true
                    }
                  },
                  {
                    "key": "email",
                    "type": "email",
                    "label": "Email"
                  },
                  {
                    "key": "confirm",
                    "type": "email",
                    "label": "Confirm",
                    "validation": {
                      "matchField": "email"
                    }
                  },
                  {
                    "key": "diet",
                    "type": "select",
                    "label": "Diet",
                    "defaultValue": "none",
                    "options": [
                      {
                        "value": "none",
                        "label": "none"
                      },
                      {
                        "value": "other",
                        "label": "other"
                      }
                    ]
                  },
                  {
                    "key": "dietNote",
                    "type": "text",
                    "label": "Details",
                    "show": [
                      {
                        "field": "diet",
                        "eq": "other"
                      }
                    ],
                    "validation": {
                      "required": true
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "values": {
        "title": "T",
        "people": [
          {
            "name": "A"
          },
          {
            "name": "B"
          }
        ]
      },
      "steps": [
        {
          "do": "setErrors",
          "errors": {
            "people.1.name": "Taken"
          }
        },
        {
          "expect": {
            "step": "two",
            "stepErrors": {
              "two": ["people.1.name"]
            }
          }
        }
      ]
    },
