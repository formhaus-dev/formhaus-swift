    {
      "name": "clears an item match error when the outer field changes to match",
      "definition": {
        "id": "edge",
        "title": "edge",
        "submit": {
          "label": "Send"
        },
        "formatVersion": "1.1",
        "fields": [
          {
            "key": "company",
            "type": "checkbox",
            "label": "Company"
          },
          {
            "key": "email",
            "type": "email",
            "label": "Email"
          },
          {
            "key": "people",
            "type": "group",
            "label": "People",
            "fields": [
              {
                "key": "diet",
                "type": "select",
                "label": "Diet",
                "options": [
                  {
                    "value": "none",
                    "label": "none"
                  },
                  {
                    "value": "other",
                    "label": "other"
                  }
                ]
              },
              {
                "key": "note",
                "type": "text",
                "label": "Note",
                "show": [
                  {
                    "field": "diet",
                    "eq": "other"
                  }
                ]
              },
              {
                "key": "vat",
                "type": "text",
                "label": "VAT",
                "show": [
                  {
                    "field": "company",
                    "eq": true
                  }
                ]
              },
              {
                "key": "confirm",
                "type": "email",
                "label": "Confirm",
                "validation": {
                  "matchField": "email"
                }
              }
            ]
          }
        ]
      },
      "values": {
        "email": "a@x.io",
        "people": [
          {
            "confirm": "b@x.io"
          }
        ]
      },
      "steps": [
        {
          "do": "validate",
          "returns": {
            "people.0.confirm": "Fields must match"
          }
        },
        {
          "do": "setValue",
          "key": "email",
          "value": "b@x.io"
        },
        {
          "expect": {
            "errors": {}
          }
        }
      ]
    },
    {
      "name": "moves loading flags with their items",
      "definition": {
        "id": "edge",
        "title": "edge",
        "submit": {
          "label": "Send"
        },
        "formatVersion": "1.1",
        "fields": [
