          "expect": {
            "errors": {
              "people.0.dietNote": "This field is required"
            }
          }
        },
        {
          "do": "setItemValue",
          "key": "people",
          "index": 0,
          "field": "dietNote",
          "value": "Vegan"
        },
        {
          "do": "setItemValue",
          "key": "people",
          "index": 0,
          "field": "diet",
          "value": "none"
        },
        {
          "expect": {
            "values": {
              "people": [
                {
                  "name": "A",
                  "diet": "none"
                }
              ]
            },
            "errors": {}
          }
        }
      ]
    },
