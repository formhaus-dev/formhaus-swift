{
  "$schema": "./scenario.schema.json",
  "name": "lifecycle values",
  "definition": {
    "id": "basic",
    "title": "Basic Form",
    "submit": {
      "label": "Submit"
    },
    "fields": [
      {
        "key": "name",
        "type": "text",
        "label": "Name",
        "validation": {
          "required": true
        }
      },
      {
        "key": "email",
        "type": "email",
        "label": "Email"
      }
    ]
  },
  "scenarios": [
    {
      "name": "applies initialValues",
      "values": {
        "name": "John"
      },
      "steps": [
        {
          "expect": {
            "values": {
              "name": "John"
            }
          }
        }
      ]
    },
    {
      "name": "applies field defaultValue",
      "definition": {
        "id": "defaults",
        "title": "Defaults",
        "submit": {
          "label": "Submit"
        },
        "fields": [
          {
            "key": "country",
            "type": "select",
            "label": "Country",
            "defaultValue": "US"
          }
        ]
      },
      "steps": [
        {
          "expect": {
            "values": {
              "country": "US"
            }
          }
        }
      ]
    },
    {
      "name": "initialValues override defaultValue",
      "definition": {
        "id": "defaults",
        "title": "Defaults",
        "submit": {
          "label": "Submit"
        },
        "fields": [
          {
            "key": "country",
            "type": "select",
            "label": "Country",
            "defaultValue": "US"
          }
        ]
      },
      "values": {
        "country": "MX"
      },
      "steps": [
        {
          "expect": {
            "values": {
              "country": "MX"
            }
          }
        }
      ]
    },
    {
      "name": "sets a value and clears field error",
      "steps": [
        {
          "do": "setErrors",
          "errors": {
            "name": "Required"
          }
        },
        {
          "do": "setValue",
          "key": "name",
          "value": "John"
        },
        {
          "expect": {
            "values": {
              "name": "John"
            },
            "errors": {}
          }
        }
      ]
    },
    {
      "name": "clears hidden fields on cascade",
      "definition": {
        "id": "conditional",
        "title": "Conditional",
        "submit": {
          "label": "Submit"
        },
        "fields": [
          {
            "key": "country",
            "type": "select",
            "label": "Country",
            "options": [
              {
                "value": "MX",
                "label": "Mexico"
              },
              {
                "value": "US",
                "label": "US"
              }
            ]
          },
          {
            "key": "clabe",
            "type": "text",
            "label": "CLABE",
            "show": [
              {
                "field": "country",
                "eq": "MX"
              }
            ]
          },
          {
            "key": "routing",
            "type": "text",
            "label": "Routing",
            "show": [
              {
                "field": "country",
                "eq": "US"
              }
            ]
          }
        ]
      },
      "values": {
        "country": "MX",
        "clabe": "123"
      },
      "steps": [
        {
          "expect": {
            "values": {
              "country": "MX",
              "clabe": "123"
            }
          }
        },
        {
          "do": "setValue",
          "key": "country",
          "value": "US"
        },
        {
          "expect": {
            "values": {
              "country": "US"
            }
          }
        }
      ]
    },
    {
      "name": "cascade: field A hides field B which hides field C",
      "definition": {
        "id": "cascade",
        "title": "Cascade",
        "submit": {
          "label": "Submit"
        },
        "fields": [
          {
            "key": "a",
            "type": "select",
            "label": "A"
          },
          {
            "key": "b",
            "type": "text",
            "label": "B",
            "show": [
              {
                "field": "a",
                "eq": "show"
              }
            ]
          },
          {
            "key": "c",
            "type": "text",
            "label": "C",
            "show": [
              {
                "field": "b",
                "notEmpty": true
              }
            ]
          }
        ]
      },
      "values": {
        "a": "show",
        "b": "hello",
        "c": "world"
      },
      "steps": [
        {
          "expect": {
            "values": {
              "a": "show",
              "b": "hello",
              "c": "world"
            }
          }
        },
        {
          "do": "setValue",
          "key": "a",
          "value": "hide"
        },
        {
          "expect": {
            "values": {
              "a": "hide"
            }
          }
        }
      ]
    },
