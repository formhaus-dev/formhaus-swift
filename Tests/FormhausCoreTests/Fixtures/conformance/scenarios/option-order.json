      "steps": [
        {
          "expect": {
            "options": {
              "team.role": ["product", "research", "engineering", "design"],
              "team.0.role": ["product", "research", "engineering", "design"],
              "team.1.role": ["product", "research", "engineering", "design"]
            }
          }
        }
      ]
    },
    {
