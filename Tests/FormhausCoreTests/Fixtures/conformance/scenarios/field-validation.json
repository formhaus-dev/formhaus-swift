{
  "$schema": "./scenario.schema.json",
  "name": "field-validation",
  "definition": {
    "id": "field-validation",
    "title": "",
    "submit": {
      "label": "Send"
    },
    "fields": [
      {
        "key": "required",
        "type": "text",
        "label": "required",
        "validation": {
          "required": true
        }
      },
      {
        "key": "requiredCustom",
        "type": "text",
        "label": "requiredCustom",
        "validation": {
          "required": "Please enter your name"
        }
      },
      {
        "key": "minLength",
        "type": "text",
        "label": "minLength",
        "validation": {
          "minLength": 3
        }
      },
      {
        "key": "minLengthCustom",
        "type": "text",
        "label": "minLengthCustom",
        "validation": {
          "minLength": 3,
          "minLengthMessage": "Too short!"
        }
      },
      {
        "key": "maxLength",
        "type": "text",
        "label": "maxLength",
        "validation": {
          "maxLength": 5
        }
      },
      {
        "key": "range",
        "type": "number",
        "label": "range",
        "validation": {
          "min": 10,
          "max": 100
        }
      },
      {
        "key": "minOnly",
        "type": "number",
        "label": "minOnly",
        "validation": {
          "min": 10
        }
      },
      {
        "key": "maxOnly",
        "type": "number",
        "label": "maxOnly",
        "validation": {
          "max": 100
        }
      },
      {
        "key": "digits",
        "type": "text",
        "label": "digits",
        "validation": {
          "pattern": "^[0-9]+$",
          "patternMessage": "Numbers only"
        }
      },
      {
        "key": "digitsDefault",
        "type": "text",
        "label": "digitsDefault",
        "validation": {
          "pattern": "^[0-9]+$"
        }
      },
      {
        "key": "code",
        "type": "code",
        "label": "code",
        "validation": {
          "pattern": "^\\d+$"
        }
      },
      {
        "key": "codeMax",
        "type": "code",
        "label": "codeMax",
        "validation": {
          "pattern": "^\\d+$",
          "maxLength": 5
        }
      },
      {
        "key": "email",
        "type": "text",
        "label": "email"
      },
      {
        "key": "confirmEmail",
        "type": "text",
        "label": "confirmEmail",
        "validation": {
          "matchField": "email"
        }
      },
      {
        "key": "password",
        "type": "text",
        "label": "password"
      },
      {
        "key": "confirmPassword",
        "type": "text",
        "label": "confirmPassword",
        "validation": {
          "matchField": "password",
          "matchFieldMessage": "Must match"
        }
      },
      {
        "key": "custom",
        "type": "text",
        "label": "custom",
        "validation": {
          "validator": "customCheck"
        }
      },
      {
        "key": "unregistered",
        "type": "text",
        "label": "unregistered",
        "validation": {
          "validator": "nonExistent"
        }
      },
      {
        "key": "tagsRequired",
        "type": "multiselect",
        "label": "tagsRequired",
        "validation": {
          "required": true
        }
      },
      {
        "key": "tagsMin",
        "type": "multiselect",
        "label": "tagsMin",
        "validation": {
          "minLength": 2
        }
      },
      {
        "key": "tagsMax",
        "type": "multiselect",
        "label": "tagsMax",
        "validation": {
          "maxLength": 2
        }
      },
      {
        "key": "tagsRange",
        "type": "multiselect",
        "label": "tagsRange",
        "validation": {
          "minLength": 1,
          "maxLength": 3
        }
      },
      {
        "key": "plain",
        "type": "text",
        "label": "plain"
      },
      {
        "key": "trimRequired",
        "type": "text",
        "label": "trimRequired",
        "validation": {
          "required": true
        }
      },
      {
        "key": "trimEmail",
        "type": "email",
        "label": "trimEmail",
        "validation": {
          "required": true
        }
      },
      {
        "key": "trimMin",
        "type": "text",
        "label": "trimMin",
        "validation": {
          "minLength": 3
        }
      },
      {
        "key": "secret",
        "type": "password",
        "label": "secret",
        "validation": {
          "required": true
        }
      }
    ]
  },
  "scenarios": [
    {
      "name": "returns error for empty string",
      "values": {
        "required": ""
      },
      "steps": [
        {
          "do": "validateField",
          "key": "required",
          "returns": "This field is required"
        }
      ]
    },
    {
      "name": "returns error for null",
      "values": {
        "required": null
      },
      "steps": [
        {
          "do": "validateField",
          "key": "required",
          "returns": "This field is required"
        }
      ]
    },
    {
      "name": "returns error for undefined",
      "steps": [
        {
          "do": "validateField",
          "key": "required",
          "returns": "This field is required"
        }
      ]
    },
    {
      "name": "returns custom message when string provided",
      "values": {
        "requiredCustom": ""
      },
      "steps": [
        {
          "do": "validateField",
          "key": "requiredCustom",
          "returns": "Please enter your name"
        }
      ]
    },
    {
      "name": "passes for non-empty value",
      "values": {
        "required": "hello"
      },
      "steps": [
        {
          "do": "validateField",
          "key": "required",
          "returns": null
        }
      ]
    },
    {
      "name": "returns error when too short",
      "values": {
        "minLength": "ab"
      },
      "steps": [
        {
          "do": "validateField",
          "key": "minLength",
          "returns": "Minimum length is 3"
        }
      ]
    },
    {
      "name": "returns custom message",
      "values": {
        "minLengthCustom": "ab"
      },
      "steps": [
        {
          "do": "validateField",
          "key": "minLengthCustom",
          "returns": "Too short!"
        }
      ]
    },
    {
      "name": "passes when long enough",
      "values": {
        "minLength": "abc"
      },
      "steps": [
        {
          "do": "validateField",
          "key": "minLength",
          "returns": null
        }
      ]
    },
    {
      "name": "skips check on empty non-required field",
      "values": {
        "minLength": ""
      },
      "steps": [
        {
          "do": "validateField",
          "key": "minLength",
          "returns": null
        }
      ]
    },
    {
      "name": "returns error when too long",
      "values": {
        "maxLength": "abcdef"
      },
      "steps": [
        {
          "do": "validateField",
          "key": "maxLength",
          "returns": "Maximum length is 5"
        }
      ]
    },
    {
      "name": "passes when within limit",
      "values": {
        "maxLength": "abc"
      },
      "steps": [
        {
          "do": "validateField",
          "key": "maxLength",
          "returns": null
        }
      ]
    },
    {
      "name": "returns error when below min",
      "values": {
        "minOnly": 5
      },
      "steps": [
        {
          "do": "validateField",
          "key": "minOnly",
          "returns": "Must be at least 10"
        }
      ]
    },
    {
      "name": "returns error when above max",
      "values": {
        "maxOnly": 150
      },
      "steps": [
        {
          "do": "validateField",
          "key": "maxOnly",
          "returns": "Must be at most 100"
        }
      ]
    },
    {
      "name": "passes when in range",
      "values": {
        "range": 50
      },
      "steps": [
        {
          "do": "validateField",
          "key": "range",
          "returns": null
        }
      ]
    },
    {
      "name": "returns error when pattern fails",
      "values": {
        "digits": "abc"
      },
      "steps": [
        {
          "do": "validateField",
          "key": "digits",
          "returns": "Numbers only"
        }
      ]
    },
    {
      "name": "passes when pattern matches",
      "values": {
        "digitsDefault": "123"
      },
      "steps": [
        {
          "do": "validateField",
          "key": "digitsDefault",
          "returns": null
        }
      ]
    },
    {
      "name": "fails values longer than 10,000 characters without matching them",
      "steps": [
        {
          "do": "setValue",
          "key": "code",
          "value": ""
        },
        {
          "do": "validateField",
          "key": "code",
          "returns": null
        },
        {
          "do": "setValue",
          "key": "code",
          "value": ""
        },
        {
          "do": "validateField",
          "key": "code",
          "returns": "Invalid format"
        },
        {
          "do": "setValue",
          "key": "codeMax",
          "value": ""
        },
        {
          "do": "validateField",
          "key": "codeMax",
          "returns": "Maximum length is 5"
        }
      ]
    },
    {
      "name": "returns error when fields differ",
      "values": {
        "email": "x@y.com",
        "confirmEmail": "a@b.com"
      },
      "steps": [
        {
          "do": "validateField",
          "key": "confirmEmail",
          "returns": "Fields must match"
        }
      ]
    },
    {
      "name": "passes when fields match",
      "values": {
        "email": "a@b.com",
        "confirmEmail": "a@b.com"
      },
      "steps": [
        {
          "do": "validateField",
          "key": "confirmEmail",
          "returns": null
        }
      ]
    },
    {
      "name": "fails an empty matchField when the other field has a value",
      "values": {
        "password": "secret",
        "confirmPassword": ""
      },
      "steps": [
        {
          "do": "validateField",
          "key": "confirmPassword",
          "returns": "Must match"
        }
      ]
    },
    {
      "name": "passes an empty matchField when the other field is missing",
      "values": {
        "confirmPassword": ""
      },
      "steps": [
        {
          "do": "validateField",
          "key": "confirmPassword",
          "returns": null
        }
      ]
    },
    {
      "name": "calls custom validator and returns its result",
      "values": {
        "custom": "test"
      },
      "validators": {
        "customCheck": {
          "reject": ["test"],
          "error": "Custom error"
        }
      },
      "steps": [
        {
          "do": "validateField",
          "key": "custom",
          "returns": "Custom error"
        }
      ]
    },
    {
      "name": "returns null when custom validator passes",
      "values": {
        "custom": "test"
      },
      "validators": {
        "customCheck": {
          "reject": [],
          "error": "Custom error"
        }
      },
      "steps": [
        {
          "do": "validateField",
          "key": "custom",
          "returns": null
        }
      ]
    },
    {
      "name": "skips when validator not found in registry",
      "values": {
        "unregistered": "test"
      },
      "steps": [
        {
          "do": "validateField",
          "key": "unregistered",
          "returns": null
        }
      ]
    },
    {
      "name": "treats empty array as empty for required",
      "values": {
        "tagsRequired": []
      },
      "steps": [
        {
          "do": "validateField",
          "key": "tagsRequired",
          "returns": "This field is required"
        }
      ]
    },
    {
      "name": "passes required with non-empty array",
      "values": {
        "tagsRequired": ["a", "b"]
      },
      "steps": [
        {
          "do": "validateField",
          "key": "tagsRequired",
          "returns": null
        }
      ]
    },
    {
      "name": "minLength checks array length",
      "values": {
        "tagsMin": ["a"]
      },
      "steps": [
        {
          "do": "validateField",
          "key": "tagsMin",
          "returns": "At least 2 required"
        }
      ]
    },
    {
      "name": "maxLength checks array length",
      "values": {
        "tagsMax": ["a", "b", "c"]
      },
      "steps": [
        {
          "do": "validateField",
          "key": "tagsMax",
          "returns": "At most 2 allowed"
        }
      ]
    },
    {
      "name": "passes minLength/maxLength with correct count",
      "values": {
        "tagsRange": ["a", "b"]
      },
      "steps": [
        {
          "do": "validateField",
          "key": "tagsRange",
          "returns": null
        }
      ]
    },
    {
      "name": "returns null when no validation object",
      "values": {
        "plain": "anything"
      },
      "steps": [
        {
          "do": "validateField",
          "key": "plain",
          "returns": null
        }
      ]
    },
    {
      "name": "treats a whitespace-only required value as empty",
      "values": {
        "trimRequired": "   "
      },
      "steps": [
        {
          "do": "validateField",
          "key": "trimRequired",
          "returns": "This field is required"
        }
      ]
    },
    {
      "name": "accepts an email with surrounding spaces",
      "values": {
        "trimEmail": "  a@b.co "
      },
      "steps": [
        {
          "do": "validateField",
          "key": "trimEmail",
          "returns": null
        }
      ]
    },
    {
      "name": "checks length on the trimmed value",
      "values": {
        "trimMin": " ab "
      },
      "steps": [
        {
          "do": "validateField",
          "key": "trimMin",
          "returns": "Minimum length is 3"
        }
      ]
    },
    {
      "name": "does not trim a password",
      "values": {
        "secret": "   "
      },
      "steps": [
        {
          "do": "validateField",
          "key": "secret",
          "returns": null
        }
      ]
    }
  ]
}
