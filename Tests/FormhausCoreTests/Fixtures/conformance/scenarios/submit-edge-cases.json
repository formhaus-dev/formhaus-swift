{
  "$schema": "./scenario.schema.json",
  "name": "submit edge cases",
  "definition": {
    "id": "flat-api",
    "title": "Open an account",
    "submit": {
      "label": "Open account"
    },
    "steps": [
      {
        "id": "about",
        "title": "About you",
        "fields": [
          {
            "key": "firstName",
            "type": "text",
            "label": "First name",
            "validation": {
              "required": true
            }
          },
          {
            "key": "lastName",
            "type": "text",
            "label": "Last name",
            "validation": {
              "required": true
            }
          },
          {
            "key": "email",
            "type": "email",
            "label": "Email",
            "validation": {
              "required": true
            }
          }
        ]
      },
      {
        "id": "account",
        "title": "Account",
        "fields": [
          {
            "key": "accountType",
            "type": "radio",
            "label": "Account type",
            "validation": {
              "required": true
            },
            "options": [
              {
                "value": "personal",
                "label": "Personal"
              },
              {
                "value": "business",
                "label": "Business"
              }
            ]
          },
          {
            "key": "companyName",
            "type": "text",
            "label": "Company name",
            "validation": {
              "required": true
            },
            "show": [
              {
                "field": "accountType",
                "eq": "business"
              }
            ]
          }
        ]
      },
      {
        "id": "address",
        "title": "Address",
        "fields": [
          {
            "key": "street",
            "type": "text",
            "label": "Street",
            "validation": {
              "required": true
            }
          },
          {
            "key": "postcode",
            "type": "text",
            "label": "Postcode",
            "validation": {
              "required": true,
              "pattern": "^[0-9]{5}$",
              "patternMessage": "Enter 5 digits"
            }
          }
        ]
      }
    ]
  },
  "scenarios": [
    {
      "name": "ignores a second submit while the first one is pending",
      "values": {
        "firstName": "Ada",
        "lastName": "Lovelace",
        "email": "ada@example.com",
        "accountType": "personal",
        "street": "1 Main St",
        "postcode": "10115"
      },
      "steps": [
        {
          "do": "goToStepWithField",
          "key": "postcode"
        },
        {
          "do": "submit",
          "handler": [
            {
              "defer": "response",
              "return": {
                "ok": true
              }
            }
          ],
          "await": false,
          "returns": true
        },
        {
          "do": "submit",
          "handler": [],
          "returns": false
        },
        {
          "do": "resolve",
          "deferred": "response"
        },
        {
          "do": "settle"
        },
        {
          "expect": {
            "log": [
              {
                "event": {
                  "type": "form_submitted",
                  "fieldCount": 6
                }
              },
              {
                "call": "submit",
                "values": {
                  "firstName": "Ada",
                  "lastName": "Lovelace",
                  "email": "ada@example.com",
                  "accountType": "personal",
                  "street": "1 Main St",
                  "postcode": "10115"
                },
                "skippedSteps": []
              },
              {
                "event": {
                  "type": "form_submit_succeeded"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "ignores a response that arrives after reset",
      "values": {
        "firstName": "Ada",
        "lastName": "Lovelace",
        "email": "ada@example.com",
        "accountType": "personal",
        "street": "1 Main St",
        "postcode": "10115"
      },
      "hooks": {
        "onAfterSubmit": []
      },
      "steps": [
        {
          "do": "goToStepWithField",
          "key": "postcode"
        },
        {
          "do": "submit",
          "handler": [
            {
              "defer": "response",
              "return": {
                "ok": false,
                "errors": {
                  "firstName": "Old"
                }
              }
            }
          ],
          "await": false,
          "returns": false
        },
        {
          "do": "reset",
          "values": {
            "firstName": "Grace"
          }
        },
        {
          "do": "resolve",
          "deferred": "response"
        },
        {
          "do": "settle"
        },
        {
          "expect": {
            "errors": {},
            "log": [
              {
                "event": {
                  "type": "form_submitted",
                  "fieldCount": 6
                }
              },
              {
                "call": "submit",
                "values": {
                  "firstName": "Ada",
                  "lastName": "Lovelace",
                  "email": "ada@example.com",
                  "accountType": "personal",
                  "street": "1 Main St",
                  "postcode": "10115"
                },
                "skippedSteps": []
              },
              {
                "event": {
                  "type": "form_submit_failed",
                  "reason": "rejected"
                }
              }
            ]
          }
        }
      ]
    },
