    {
      "name": "restores the other answers of a skipped step edited before its late rejection",
      "definition": {
        "id": "same-step",
        "title": "Same step",
        "submit": {
          "label": "Send"
        },
        "steps": [
          {
            "id": "profile",
            "title": "Profile",
            "fields": [
              {
                "key": "name",
                "type": "text",
                "label": "Name"
              }
            ]
          },
          {
            "id": "details",
            "title": "Details",
            "skip": {
              "label": "Skip"
            },
            "fields": [
              {
                "key": "bio",
                "type": "text",
                "label": "Bio"
              },
              {
                "key": "site",
                "type": "text",
                "label": "Site"
              }
            ]
          }
        ]
      },
      "values": {
        "name": "Ada",
        "bio": "Draft",
        "site": "ada.dev"
      },
      "steps": [
        {
          "do": "goToStepWithField",
          "key": "bio"
        },
        {
