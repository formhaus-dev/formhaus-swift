    {
      "name": "drops errors for fields edited while the request was running",
      "values": {
        "firstName": "Ada",
        "lastName": "Lovelace",
        "email": "ada@example.com",
        "accountType": "personal",
        "street": "1 Main St",
        "postcode": "10115"
      },
      "steps": [
        {
          "do": "goToStepWithField",
          "key": "postcode"
        },
        {
          "do": "submit",
          "handler": [
            {
              "defer": "response",
              "return": {
                "ok": false,
                "errors": {
                  "postcode": "Unknown",
                  "email": "Taken"
                }
              }
            }
          ],
          "await": false,
          "returns": false
        },
        {
          "do": "setValue",
          "key": "postcode",
          "value": "10117"
        },
        {
          "do": "resolve",
          "deferred": "response"
        },
        {
          "do": "settle"
        },
        {
          "expect": {
            "errors": {
              "email": "Taken"
            },
            "values": {
              "firstName": "Ada",
              "lastName": "Lovelace",
              "email": "ada@example.com",
              "accountType": "personal",
              "street": "1 Main St",
              "postcode": "10117"
            }
          }
        }
      ]
    },
