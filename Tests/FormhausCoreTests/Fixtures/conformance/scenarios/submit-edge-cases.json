    {
      "name": "keeps an answer typed into a cleared field when a cancelled skip is rejected late",
      "definition": {
        "id": "late-skip",
        "title": "Late skip",
        "submit": {
          "label": "Send"
        },
        "steps": [
          {
            "id": "note",
            "title": "Note",
            "skip": {
              "label": "Skip"
            },
            "fields": [
              {
                "key": "note",
                "type": "text",
                "label": "Note"
              },
              {
                "key": "more",
                "type": "text",
                "label": "More",
                "show": [
                  {
                    "field": "note",
                    "eq": "more"
                  }
                ]
              }
            ]
          }
        ]
      },
      "values": {
        "note": "hello"
      },
      "steps": [
        {
          "do": "skip",
          "handler": [
            {
              "defer": "response",
              "return": {
                "ok": false
              }
            }
          ],
          "await": false,
          "returns": false
        },
        {
          "do": "cancelPendingActions"
        },
        {
          "do": "setValue",
          "key": "note",
          "value": "more"
        },
        {
          "do": "setErrors",
          "errors": {
            "more": "Required"
          }
        },
        {
          "do": "resolve",
          "deferred": "response"
        },
        {
          "do": "settle"
        },
        {
          "expect": {
            "values": {
              "note": "more"
            },
            "errors": {
              "more": "Required"
            }
          }
        }
      ]
    },
