    {
      "name": "keeps a newer rejection when a cancelled skip settles late",
      "definition": {
        "id": "stale-skip",
        "title": "Stale skip",
        "submit": {
          "label": "Send"
        },
        "steps": [
          {
            "id": "profile",
            "title": "Profile",
            "fields": [
              {
                "key": "name",
                "type": "text",
                "label": "Name"
              }
            ]
          },
          {
            "id": "details",
            "title": "Details",
            "skip": {
              "label": "Skip"
            },
            "fields": [
              {
                "key": "bio",
                "type": "text",
                "label": "Bio"
              }
            ]
          }
        ]
      },
      "values": {
        "name": "Ada",
        "bio": "Draft"
      },
      "steps": [
        {
          "do": "setErrors",
          "errors": {
            "bio": "Old"
          }
        },
        {
          "do": "skip",
          "handler": [
            {
              "defer": "response",
              "return": {
                "ok": false,
                "errors": {
                  "name": "Stale"
                }
              }
            }
          ],
          "await": false,
          "returns": false
        },
        {
          "do": "cancelPendingActions"
        },
        {
          "do": "submit",
          "handler": [
            {
              "return": {
                "ok": false,
                "errors": {
                  "name": "Fresh"
                }
              }
            }
          ],
          "returns": false
        },
        {
          "expect": {
            "values": {
              "name": "Ada"
            }
          }
        },
        {
          "do": "resolve",
          "deferred": "response"
        },
        {
          "do": "settle"
        },
        {
          "expect": {
            "values": {
              "name": "Ada"
            },
            "errors": {
              "name": "Fresh"
            }
          }
        },
        {
          "do": "validate"
        },
        {
          "expect": {
            "errors": {
              "name": "Fresh"
            }
          }
        }
      ]
    },
