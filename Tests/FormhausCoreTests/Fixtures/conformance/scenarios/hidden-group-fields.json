      ]
    },
    {
      "name": "reports a client error on a hidden item field at form level",
      "values": {
        "members": [
          {
            "id": "a1",
            "name": "Ann"
          },
          {
            "id": "Bad id",
            "name": "Bob"
          }
        ]
      },
      "steps": [
        {
          "do": "next",
          "returns": false
        },
        {
          "expect": {
            "errors": {
              "members.1.id": "Unknown member"
            },
            "topLevelErrors": ["Unknown member"],
            "stepErrors": {},
            "step": "members"
          }
        },
        {
          "do": "moveItem",
          "key": "members",
          "from": 1,
          "to": 0,
          "returns": true
        },
        {
          "expect": {
            "errors": {
              "members.0.id": "Unknown member"
            },
            "topLevelErrors": ["Unknown member"]
          }
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 0,
          "field": "id",
          "value": "b2"
        },
        {
          "do": "next",
          "returns": true
        },
        {
          "expect": {
            "errors": {},
            "topLevelErrors": [],
            "step": "review"
          }
        }
      ]
    },
    {
      "name": "wraps the built-in message of a hidden item field with its label",
      "values": {
        "members": [
          {
            "id": 5,
            "name": "Ann"
          }
        ]
      },
      "steps": [
        {
          "do": "validate",
          "returns": {
            "members.0.id": "Member id: Must be text"
          }
        },
        {
          "expect": {
            "topLevelErrors": ["Member id: Must be text"]
          }
        }
      ]
    },
    {
      "name": "turns a server error on a hidden item field into a form-level error without moving steps",
      "values": {
        "members": [
          {
            "id": "a1",
            "name": "Ann"
          },
          {
            "id": "b2",
            "name": "Bob"
          }
        ]
      },
      "steps": [
        {
          "do": "next",
          "returns": true
        },
        {
          "do": "setErrors",
          "errors": {
            "members.1.id": "Member was removed"
          }
        },
        {
          "expect": {
            "errors": {
              "members.1.id": "Member was removed"
            },
            "topLevelErrors": ["Member was removed"],
            "stepErrors": {},
            "step": "review"
          }
        },
        {
          "do": "setErrors",
          "errors": {
            "members.1.id": "Member was removed",
            "members.0.name": "Taken"
          }
        },
        {
          "expect": {
            "topLevelErrors": ["Member was removed"],
            "stepErrors": {
              "members": ["members.0.name"]
            },
            "step": "members"
          }
        }
      ]
    },
    {
      "name": "gives a hidden item field its start value when its item conditions match again",
      "values": {
        "members": [
          {
            "id": "a1",
            "name": "Ann",
            "role": "admin",
            "grant": "full",
            "note": "lead"
          }
        ]
      },
      "steps": [
        {
          "do": "setItemValue",
          "key": "members",
          "index": 0,
          "field": "note",
          "value": "owner"
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 0,
          "field": "grant",
          "value": "temp"
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 0,
          "field": "role",
          "value": "viewer"
        },
        {
          "expect": {
            "values": {
              "members": [
                {
                  "id": "a1",
                  "name": "Ann",
                  "role": "viewer"
                }
              ]
            }
          }
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 0,
          "field": "grant",
          "value": "written"
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 0,
          "field": "role",
          "value": "admin"
        },
        {
          "expect": {
            "values": {
              "members": [
                {
                  "id": "a1",
                  "name": "Ann",
                  "role": "admin",
                  "grant": "full",
                  "note": "owner"
                }
              ]
            }
          }
        },
        {
          "do": "addItem",
          "key": "members",
          "returns": true
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 1,
          "field": "role",
          "value": "admin"
        },
        {
          "expect": {
            "values": {
              "members": [
                {
                  "id": "a1",
                  "name": "Ann",
                  "role": "admin",
                  "grant": "full",
                  "note": "owner"
                },
                {
                  "id": "new",
                  "role": "admin",
                  "grant": "basic",
                  "note": "hi"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "keeps a hidden item field hidden by its item conditions with hiddenValues keep",
      "hiddenValues": "keep",
      "values": {
        "members": [
          {
            "id": "a1",
            "name": "Ann",
            "role": "viewer",
            "grant": "full"
          }
        ]
      },
      "steps": [
        {
          "expect": {
            "submitValues": {
              "members": [
                {
                  "id": "a1",
                  "name": "Ann",
                  "role": "viewer",
                  "grant": "full",
                  "note": "hi"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "tracks unsaved changes of a hidden item field by item path",
      "values": {
        "members": [
          {
            "id": "a1",
            "name": "Ann"
          },
          {
            "id": "b2",
            "name": "Bob"
          }
        ]
      },
      "steps": [
        {
          "expect": {
            "dirty": false
          }
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 1,
          "field": "id",
          "value": "c3"
        },
        {
          "expect": {
            "dirty": true,
            "dirtyKeys": ["members.1.id"]
          }
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 1,
          "field": "id",
          "value": "b2"
        },
        {
          "expect": {
            "dirty": false
          }
        }
      ]
    },
