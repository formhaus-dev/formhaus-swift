{
  "$schema": "./scenario.schema.json",
  "name": "hidden-group-fields",
  "definition": {
    "formatVersion": "1.9",
    "id": "team",
    "title": "Team",
    "submit": {
      "label": "Save"
    },
    "steps": [
      {
        "id": "members",
        "title": "Members",
        "fields": [
          {
            "key": "members",
            "type": "group",
            "label": "Members",
            "reorderable": true,
            "validation": {
              "maxLength": 4
            },
            "fields": [
              {
                "key": "id",
                "type": "hidden",
                "label": "Member id",
                "defaultValue": "new",
                "validation": {
                  "pattern": "^[a-z0-9]+$",
                  "patternMessage": "Unknown member"
                }
              },
              {
                "key": "name",
                "type": "text",
                "label": "Name",
                "validation": {
                  "required": true
                }
              },
              {
                "key": "role",
                "type": "radio",
                "label": "Role",
                "options": [
                  {
                    "value": "admin",
                    "label": "Admin"
                  },
                  {
                    "value": "viewer",
                    "label": "Viewer"
                  }
                ]
              },
              {
                "key": "grant",
                "type": "hidden",
                "label": "Grant",
                "defaultValue": "basic",
                "show": [
                  {
                    "field": "role",
                    "eq": "admin"
                  }
                ]
              },
              {
                "key": "note",
                "type": "text",
                "label": "Note",
                "defaultValue": "hi",
                "show": [
                  {
                    "field": "role",
                    "eq": "admin"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "review",
        "title": "Review",
        "fields": [
          {
            "key": "comment",
            "type": "textarea",
            "label": "Comment"
          }
        ]
      }
    ]
  },
  "scenarios": [
    {
      "name": "keeps the hidden values of each item through add, move and remove",
      "values": {
        "members": [
          {
            "id": "a1",
            "name": "Ann"
          },
          {
            "id": "b2",
            "name": "Bob"
          }
        ]
      },
      "steps": [
        {
          "do": "addItem",
          "key": "members",
          "returns": true
        },
        {
          "expect": {
            "values": {
              "members": [
                {
                  "id": "a1",
                  "name": "Ann"
                },
                {
                  "id": "b2",
                  "name": "Bob"
                },
                {
                  "id": "new"
                }
              ]
            },
            "items": {
              "members": 3
            }
          }
        },
        {
          "do": "moveItem",
          "key": "members",
          "from": 0,
          "to": 2,
          "returns": true
        },
        {
          "expect": {
            "values": {
              "members": [
                {
                  "id": "b2",
                  "name": "Bob"
                },
                {
                  "id": "new"
                },
                {
                  "id": "a1",
                  "name": "Ann"
                }
              ]
            }
          }
        },
        {
          "do": "removeItem",
          "key": "members",
          "index": 1,
          "returns": true
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 1,
          "field": "name",
          "value": "Anna"
        },
        {
          "expect": {
            "submitValues": {
              "members": [
                {
                  "id": "b2",
                  "name": "Bob"
                },
                {
                  "id": "a1",
                  "name": "Anna"
                }
              ]
            },
            "distinctItemIds": {
              "members": 2
            }
          }
        }
      ]
    },
    {
      "name": "stores items written with setValue as given and gives back their written values or defaults on reveal",
      "steps": [
        {
          "do": "setValue",
          "key": "members",
          "value": [
            {
              "id": "a1",
              "name": "Ann",
              "role": "admin",
              "grant": "g2"
            },
            {
              "name": "Bob",
              "role": "viewer"
            }
          ]
        },
        {
          "expect": {
            "values": {
              "members": [
                {
                  "id": "a1",
                  "name": "Ann",
                  "role": "admin",
                  "grant": "g2"
                },
                {
                  "name": "Bob",
                  "role": "viewer"
                }
              ]
            },
            "submitValues": {
              "members": [
                {
                  "id": "a1",
                  "name": "Ann",
                  "role": "admin",
                  "grant": "g2"
                },
                {
                  "name": "Bob",
                  "role": "viewer"
                }
              ]
            }
          }
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 0,
          "field": "role",
          "value": "viewer"
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 1,
          "field": "role",
          "value": "admin"
        },
        {
          "expect": {
            "values": {
              "members": [
                {
                  "id": "a1",
                  "name": "Ann",
                  "role": "viewer"
                },
                {
                  "name": "Bob",
                  "role": "admin",
                  "grant": "basic",
                  "note": "hi"
                }
              ]
            }
          }
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 0,
          "field": "role",
          "value": "admin"
        },
        {
          "expect": {
            "values": {
              "members": [
                {
                  "id": "a1",
                  "name": "Ann",
                  "role": "admin",
                  "grant": "g2",
                  "note": "hi"
                },
                {
                  "name": "Bob",
                  "role": "admin",
                  "grant": "basic",
                  "note": "hi"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "gives an initial item without the hidden key its defaultValue",
      "values": {
        "members": [
          {
            "name": "Ann"
          }
        ]
      },
      "steps": [
        {
          "expect": {
            "values": {
              "members": [
                {
                  "id": "new",
                  "name": "Ann"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "gives items reset by Skip the defaults of their hidden fields",
      "definition": {
        "formatVersion": "1.9",
        "id": "team",
        "title": "Team",
        "submit": {
          "label": "Save"
        },
        "steps": [
          {
            "id": "members",
            "title": "Members",
            "fields": [
              {
                "key": "members",
                "type": "group",
                "label": "Members",
                "reorderable": true,
                "validation": {
                  "maxLength": 4
                },
                "fields": [
                  {
                    "key": "id",
                    "type": "hidden",
                    "label": "Member id",
                    "defaultValue": "new",
                    "validation": {
                      "pattern": "^[a-z0-9]+$",
                      "patternMessage": "Unknown member"
                    }
                  },
                  {
                    "key": "name",
                    "type": "text",
                    "label": "Name",
                    "validation": {
                      "required": true
                    }
                  },
                  {
                    "key": "role",
                    "type": "radio",
                    "label": "Role",
                    "options": [
                      {
                        "value": "admin",
                        "label": "Admin"
                      },
                      {
                        "value": "viewer",
                        "label": "Viewer"
                      }
                    ]
                  },
                  {
                    "key": "grant",
                    "type": "hidden",
                    "label": "Grant",
                    "defaultValue": "basic",
                    "show": [
                      {
                        "field": "role",
                        "eq": "admin"
                      }
                    ]
                  },
                  {
                    "key": "note",
                    "type": "text",
                    "label": "Note",
                    "defaultValue": "hi",
                    "show": [
                      {
                        "field": "role",
                        "eq": "admin"
                      }
                    ]
                  }
                ],
                "defaultItems": 1
              }
            ],
            "skip": {
              "label": "Skip"
            }
          },
          {
            "id": "review",
            "title": "Review",
            "fields": [
              {
                "key": "comment",
                "type": "textarea",
                "label": "Comment"
              }
            ]
          }
        ]
      },
      "values": {
        "members": [
          {
            "id": "a1",
            "name": "Ann",
            "role": "admin",
            "grant": "full"
          }
        ]
      },
      "steps": [
        {
          "do": "skip",
          "returns": true
        },
        {
          "do": "back",
          "returns": true
        },
        {
          "expect": {
            "values": {
              "members": [
                {
                  "id": "new"
                }
              ]
            }
          }
        },
        {
          "do": "setItemValue",
          "key": "members",
          "index": 0,
          "field": "role",
          "value": "admin"
        },
        {
          "expect": {
            "values": {
              "members": [
                {
                  "id": "new",
                  "role": "admin",
                  "grant": "basic",
                  "note": "hi"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "keeps the start values of items when their group is hidden and shown again",
      "definition": {
        "formatVersion": "1.9",
        "id": "crew",
        "title": "Crew",
        "submit": {
          "label": "Save"
        },
        "fields": [
          {
            "key": "on",
            "type": "checkbox",
            "label": "On"
          },
          {
            "key": "crew",
            "type": "group",
            "label": "Crew",
            "show": [
              {
                "field": "on",
                "eq": true
              }
            ],
            "fields": [
              {
                "key": "kind",
                "type": "radio",
                "label": "Kind",
                "options": [
                  {
                    "value": "x",
                    "label": "X"
                  },
                  {
                    "value": "y",
                    "label": "Y"
                  }
                ]
              },
              {
                "key": "id",
                "type": "hidden",
                "label": "Id",
                "defaultValue": "new",
                "show": [
                  {
                    "field": "kind",
                    "eq": "x"
                  }
                ]
              }
            ]
          }
        ]
      },
      "values": {
        "on": true,
        "crew": [
          {
            "kind": "x",
            "id": "m_1"
          }
        ]
      },
      "steps": [
        {
          "do": "setItemValue",
          "key": "crew",
          "index": 0,
          "field": "kind",
          "value": "y"
        },
        {
          "do": "setValue",
          "key": "crew",
          "value": [
            {
              "kind": "x",
              "id": "m_1"
            },
            {
              "kind": "y"
            }
          ]
        },
        {
          "do": "setValue",
          "key": "on",
          "value": false
        },
        {
          "expect": {
            "values": {
              "on": false
            }
          }
        },
        {
          "do": "setValue",
          "key": "on",
          "value": true
        },
        {
          "expect": {
            "values": {
              "on": true,
              "crew": [
                {
                  "kind": "x",
                  "id": "m_1"
                },
                {
                  "kind": "y"
                }
              ]
            }
          }
        },
        {
          "do": "setItemValue",
          "key": "crew",
          "index": 0,
          "field": "kind",
          "value": "y"
        },
        {
          "do": "setItemValue",
          "key": "crew",
          "index": 1,
          "field": "kind",
          "value": "x"
        },
        {
          "expect": {
            "values": {
              "on": true,
              "crew": [
                {
                  "kind": "y"
                },
                {
                  "kind": "x",
                  "id": "new"
                }
              ]
            }
          }
        },
        {
          "do": "setItemValue",
          "key": "crew",
          "index": 0,
          "field": "kind",
          "value": "x"
        },
        {
          "expect": {
            "values": {
              "on": true,
              "crew": [
                {
                  "kind": "x",
                  "id": "m_1"
                },
                {
                  "kind": "x",
                  "id": "new"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "gives items from defaultItems the default of their hidden fields",
      "definition": {
        "formatVersion": "1.9",
        "id": "team",
        "title": "Team",
