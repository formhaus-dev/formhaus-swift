{
  "output": {
    "name": "formhaus-swift",
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "scales": [1, 2],
    "transition": 0.7,
    "poster": { "beat": "parity", "at": 6.2 },
    "gif": { "width": 800, "fps": 15, "maxBytes": 3000000 }
  },
  "theme": {
    "fonts": {
      "sans": "'Inter Variable', Inter, ui-sans-serif, system-ui, sans-serif",
      "mono": "ui-monospace, 'SF Mono', Menlo, Monaco, monospace"
    },
    "colors": {
      "background": "{color.bg.hover}",
      "surface": "{color.bg.default}",
      "text": "{color.text.default}",
      "muted": "{color.text.muted}",
      "border": "{color.border.default}",
      "primary": "{color.primary.default}",
      "primarySoft": "{color.primary.soft}",
      "error": "{color.error.default}",
      "ink": "#0d0d15",
      "lavender": "#e7d9fa",
      "bezel": "{palette.graphite.950}",
      "bezelEdge": "{palette.graphite.700}",
      "code": "{palette.graphite.900}",
      "codeText": "{palette.graphite.50}",
      "codeMuted": "{palette.graphite.400}",
      "codeKey": "#b9a3ff",
      "codeString": "#9fe0c0",
      "success": "#1f9d55"
    }
  },
  "devices": {
    "iphone": { "kind": "iphone", "simulator": "iPhone 17 Pro", "screen": [402, 874], "radius": 62 },
    "ipad": { "kind": "ipad", "simulator": "iPad Pro 11-inch (M5)", "screen": [834, 1210], "radius": 18 },
    "browser": { "kind": "browser", "viewport": [720, 960], "scale": 2, "url": "northwind.studio/start" }
  },
  "edit": {
    "field": "currentSite",
    "property": "show.0.in",
    "value": ["redesign", "online-store", "landing-page"]
  },
  "marks": {
    "tour": { "first": 1.6, "error": 1.6, "landing": 3.8, "branch": 4.7, "back": 6.9, "condition": 7.8, "typing": 8.7, "project": 10.95, "scope": 11.85, "services": 12.75, "scoped": 15.0, "contact": 15.9, "server": 21.32, "fix": 23.52, "success": 27.36, "end": 29.6 },
    "styles": { "first": 1.6, "filled": 7.45, "system": 9.65, "brand": 12.45, "formhaus": 15.25, "end": 18.0 }
  },
  "footage": {
    "ios-tour": { "device": "iphone", "script": "tour", "definition": "base", "length": 31 },
    "ios-variant": { "device": "iphone", "script": "tour", "stop": "branch", "definition": "variant", "length": 7 },
    "ios-styles": { "device": "iphone", "script": "styles", "definition": "base", "length": 17 },
    "ipad-still": { "device": "ipad", "script": "styles", "stop": "filled", "definition": "base", "still": true },
    "web-tour": { "device": "browser", "script": "tour", "stop": "back", "definition": "base", "length": 7.6 },
    "web-variant": { "device": "browser", "script": "tour", "stop": "branch", "definition": "variant", "length": 6 }
  },
  "beats": [
    {
      "id": "schema",
      "scene": "schema",
      "duration": 6.1,
      "title": "One schema.",
      "subtitle": "A form definition in JSON.",
      "after": "The form builds itself from it.",
      "field": "projectType",
      "device": "browser"
    },
    {
      "id": "parity",
      "scene": "parity",
      "duration": 7.2,
      "devices": { "web": "browser", "ios": "iphone" },
      "clips": { "web": "web-tour", "ios": "ios-tour" },
      "from": 0.9,
      "labels": { "web": "React · @formhaus/react", "ios": "SwiftUI · FormhausUI" },
      "steps": [
        { "at": "error", "text": "Next, with nothing filled in." },
        { "at": "landing", "text": "Pick “A landing page”." },
        { "at": "branch", "text": "Both skip to Step 2 of 2." }
      ],
      "caption": { "at": "branch", "lead": 0.5, "text": "Same JSON. Same rules. Same result." }
    },
    {
      "id": "edit",
      "scene": "edit",
      "duration": 5.6,
      "devices": { "web": "browser", "ios": "iphone" },
      "clips": {
        "before": { "web": "web-tour", "ios": "ios-tour" },
        "after": { "web": "web-variant", "ios": "ios-variant" }
      },
      "hold": "landing",
      "offset": 0.5,
      "editAt": 1.6,
      "title": "Change one line.",
      "after": "Both forms follow.",
      "file": "project-inquiry.json"
    },
    {
      "id": "tour",
      "scene": "tour",
      "duration": 11.9,
      "device": "iphone",
      "clip": "ios-tour",
      "title": "The formhaus set, native.",
      "segments": [
        { "from": "condition", "lead": 0.5, "length": 2.1, "rate": 1, "label": "Picture options", "focus": 0.36, "zoom": 1.25 },
        { "from": "typing", "lead": 0.1, "length": 2.3, "rate": 1.15, "label": "Conditions and typing", "focus": 0.6, "zoom": 1.35 },
        { "from": "services", "lead": 0.2, "length": 2.5, "rate": 1.25, "label": "Choices and scales", "focus": 0.55, "zoom": 1.2 },
        { "from": "server", "lead": 0.2, "length": 2.2, "rate": 1, "label": "Server errors and focus", "focus": 0.5, "zoom": 1.3 },
        { "from": "success", "lead": -0.5, "length": 2.2, "rate": 1, "label": "Success", "focus": 0.45, "zoom": 1.1 }
      ]
    },
    {
      "id": "styles",
      "scene": "styles",
      "duration": 7.1,
      "device": "iphone",
      "clip": "ios-styles",
      "play": { "from": "system", "lead": 1.4, "until": "formhaus" },
      "title": "Bring your own components.",
      "code": "FormhausForm(model: model)",
      "sets": [
        { "at": "filled", "name": "formhaus", "line": ".formhausComponents(.standard)" },
        { "at": "system", "name": "iOS", "line": ".formhausComponents(.system)" },
        { "at": "brand", "name": "Kiln", "line": ".formhausComponents(kiln)" }
      ]
    },
    {
      "id": "proof",
      "scene": "proof",
      "duration": 4.5,
      "count": "{count} conformance scenarios",
      "engines": ["TypeScript", "Swift"],
      "note": "Every scenario runs on both engines."
    },
    {
      "id": "end",
      "scene": "end",
      "duration": 5.6,
      "title": "Same engine — web, iOS, macOS.",
      "devices": ["browser", "ipad", "iphone"],
      "stills": { "browser": "web-tour", "ipad": "ipad-still", "iphone": "ios-tour" },
      "at": { "browser": "landing", "iphone": "landing" },
      "install": ".package(url: \"https://github.com/formhaus-dev/formhaus-swift.git\", branch: \"main\")",
      "links": ["formhaus.dev", "github.com/formhaus-dev/formhaus-swift"]
    }
  ]
}
