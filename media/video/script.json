{
  "output": {
    "name": "formhaus-swift",
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "scales": [
      1,
      2
    ],
    "transition": 0.35,
    "poster": {
      "beat": "branch",
      "at": 3.6
    },
    "gif": {
      "width": 800,
      "fps": 15,
      "maxBytes": 3000000
    }
  },
  "theme": {
    "fonts": {
      "sans": "'Inter Variable', Inter, ui-sans-serif, system-ui, sans-serif",
      "mono": "ui-monospace, 'SF Mono', Menlo, Monaco, monospace"
    },
    "colors": {
      "background": "{color.bg.hover}",
      "surface": "{color.bg.default}",
      "text": "{color.text.default}",
      "muted": "{color.text.muted}",
      "border": "{color.border.default}",
      "primary": "{color.primary.default}",
      "primarySoft": "{color.primary.soft}",
      "error": "{color.error.default}",
      "ink": "#0d0d15",
      "lavender": "#e7d9fa",
      "bezel": "{palette.graphite.950}",
      "bezelEdge": "{palette.graphite.700}",
      "code": "{color.bg.default}",
      "codeText": "{color.text.default}",
      "codeMuted": "{color.text.muted}",
      "codeKey": "{color.primary.default}",
      "codeString": "#1f7a4d",
      "codeError": "{color.error.default}",
      "success": "#1f9d55"
    }
  },
  "devices": {
    "iphone": {
      "kind": "iphone",
      "simulator": "iPhone 17 Pro",
      "screen": [
        402,
        874
      ],
      "radius": 62
    },
    "browser": {
      "kind": "browser",
      "viewport": [
        720,
        960
      ],
      "scale": 2,
      "url": "northwind.studio/start"
    },
    "mac": {
      "kind": "mac",
      "window": [
        880,
        820
      ],
      "title": "Start a project"
    }
  },
  "edit": {
    "field": "currentSite",
    "property": "show.0.in",
    "value": [
      "redesign",
      "online-store",
      "landing-page"
    ]
  },
  "marks": {
    "tour": {
      "first": 1.6,
      "error": 1.6,
      "landing": 3.8,
      "branch": 4.7,
      "back": 6.9
    },
    "showcase": {
      "first": 1.6,
      "condition": 1.6,
      "typing": 2.95,
      "project": 5.65,
      "scope": 6.55,
      "services": 7.9,
      "scoped": 10.6,
      "contact": 11.5,
      "server": 16.92,
      "success": 22.96,
      "end": 25.2
    },
    "styles": {
      "first": 1.6,
      "start": 0,
      "filled": 7.45,
      "system": 9.65,
      "brand": 12.45,
      "formhaus": 15.25,
      "end": 18.0
    },
    "branch": {
      "first": 1.6,
      "landing": 1.6,
      "branch": 2.5,
      "end": 4.7
    }
  },
  "footage": {
    "ios-tour": {
      "device": "iphone",
      "script": "tour",
      "stop": "back",
      "definition": "base",
      "length": 8
    },
    "ios-showcase": {
      "device": "iphone",
      "script": "showcase",
      "definition": "base",
      "length": 27
    },
    "ios-variant": {
      "device": "iphone",
      "script": "tour",
      "stop": "branch",
      "definition": "variant",
      "length": 7
    },
    "ios-styles": {
      "device": "iphone",
      "script": "styles",
      "definition": "base",
      "length": 17
    },
    "mac-still": {
      "device": "mac",
      "definition": "base",
      "still": true
    },
    "web-tour": {
      "device": "browser",
      "script": "tour",
      "stop": "back",
      "definition": "base",
      "length": 7.6
    },
    "web-variant": {
      "device": "browser",
      "script": "tour",
      "stop": "branch",
      "definition": "variant",
      "length": 6
    },
    "ios-branch": {
      "device": "iphone",
      "script": "branch",
      "definition": "base",
      "length": 6,
      "syncTap": 1
    },
    "web-branch": {
      "device": "browser",
      "script": "branch",
      "definition": "base",
      "length": 5,
      "syncTap": 1
    }
  },
  "beats": [
    {
      "id": "launch",
      "scene": "launch",
      "duration": 4,
      "title": "Formhaus is now on iOS and macOS.",
      "subline": "Native SwiftUI, same JSON as the web.",
      "devices": {
        "mac": "mac",
        "phone": "iphone"
      },
      "stills": {
        "mac": "mac-still",
        "phone": "ios-tour"
      },
      "at": 0.8
    },
    {
      "id": "branch",
      "scene": "split",
      "duration": 4.4,
      "caption": "Same rules on every platform.",
      "captionAt": 2.2,
      "devices": {
        "web": "browser",
        "ios": "iphone"
      },
      "clips": {
        "web": "web-branch",
        "ios": "ios-branch"
      },
      "sync": {
        "web": [
          "branch",
          "landing"
        ],
        "ios": [
          "branch",
          "landing"
        ]
      },
      "from": -1.1,
      "cursor": true,
      "camera": [
        {
          "at": 0,
          "zoom": 1,
          "focus": {
            "web": "top",
            "ios": "top"
          }
        },
        {
          "at": 2.6,
          "zoom": 1.5,
          "focus": {
            "web": "top",
            "ios": "top"
          }
        }
      ]
    },
    {
      "id": "parity",
      "scene": "split",
      "duration": 6.2,
      "devices": {
        "web": "browser",
        "ios": "iphone"
      },
      "clips": {
        "web": "web-tour",
        "ios": "ios-tour"
      },
      "from": -1.4,
      "labels": {
        "web": "React · @formhaus/react",
        "ios": "SwiftUI · FormhausUI"
      },
      "steps": [
        {
          "at": "error",
          "text": "Next, with nothing filled in."
        },
        {
          "at": "landing",
          "text": "Pick “A landing page”."
        },
        {
          "at": "branch",
          "text": "Both skip to step 2."
        }
      ],
      "caption": "Same errors and branch handling on web and iOS.",
      "sync": {
        "web": [
          "tour",
          "error"
        ],
        "ios": [
          "tour",
          "error"
        ]
      },
      "captionAt": 5.0,
      "camera": [
        {
          "at": 0,
          "zoom": 1,
          "focus": {
            "web": "top",
            "ios": "top"
          }
        },
        {
          "at": 2.2,
          "zoom": 1.12,
          "focus": {
            "web": "top",
            "ios": "top"
          }
        },
        {
          "at": 4.4,
          "zoom": 1,
          "focus": {
            "web": "top",
            "ios": "top"
          }
        }
      ]
    },
    {
      "id": "edit",
      "scene": "edit",
      "duration": 5.2,
      "devices": {
        "web": "browser",
        "ios": "iphone"
      },
      "clips": {
        "before": {
          "web": "web-tour",
          "ios": "ios-tour"
        },
        "after": {
          "web": "web-variant",
          "ios": "ios-variant"
        }
      },
      "hold": "landing",
      "offset": 0.5,
      "editAt": 1.6,
      "title": "Fix it once and get it everywhere.",
      "after": "Fix it once and get it everywhere.",
      "file": "project-inquiry.json",
      "region": {
        "top": 330,
        "height": 750
      },
      "camera": [
        {
          "at": 0,
          "zoom": 1.6,
          "focus": {
            "web": "bottom",
            "ios": "bottom"
          }
        }
      ]
    },
    {
      "id": "tour",
      "scene": "tour",
      "duration": 11.2,
      "device": "iphone",
      "clip": "ios-showcase",
      "script": "showcase",
      "title": "The formhaus components run natively on iOS.",
      "segments": [
        {
          "from": "condition",
          "lead": 0.6,
          "length": 1.2,
          "rate": 1,
          "label": "Picture options",
          "focus": 0.36,
          "zoom": 1.35
        },
        {
          "from": "typing",
          "lead": 0.65,
          "length": 2.4,
          "rate": 1.6,
          "label": "Conditions and typing",
          "focus": 0.6,
          "zoom": 1.45
        },
        {
          "from": "scope",
          "lead": 0.35,
          "length": 2.5,
          "rate": 2,
          "label": "Choices and scales",
          "focus": 0.5,
          "zoom": 1.3
        },
        {
          "from": "server",
          "lead": 1.5,
          "length": 2.1,
          "rate": 1,
          "label": "Server errors and focus",
          "focus": 0.48,
          "zoom": 1.4
        },
        {
          "from": "success",
          "lead": 1.46,
          "length": 2.4,
          "rate": 1,
          "label": "Success",
          "focus": 0.45,
          "zoom": 1.3
        }
      ]
    },
    {
      "id": "looks",
      "scene": "looks",
      "duration": 5,
      "title": "Bring your own components.",
      "clip": "ios-styles",
      "sets": [
        {
          "at": "filled",
          "offset": 0.6,
          "name": "formhaus"
        },
        {
          "at": "system",
          "offset": 1.2,
          "name": "iOS system"
        },
        {
          "at": "brand",
          "offset": 1.2,
          "name": "Kiln"
        }
      ]
    },
    {
      "id": "proof",
      "scene": "proof",
      "duration": 3.9,
      "count": "shared conformance tests pass in TypeScript and Swift",
      "header": "Test",
      "engines": [
        "TypeScript",
        "Swift"
      ]
    },
    {
      "id": "end",
      "scene": "end",
      "duration": 4.8,
      "title": "Same engine for web, iOS and macOS.",
      "devices": [
        "browser",
        "mac",
        "iphone"
      ],
      "stills": {
        "browser": "web-tour",
        "mac": "mac-still",
        "iphone": "ios-tour"
      },
      "at": {
        "browser": "landing",
        "iphone": "landing"
      },
      "install": ".package(url: \"https://github.com/formhaus-dev/formhaus-swift.git\", branch: \"main\")",
      "links": [
        "formhaus.dev",
        "github.com/formhaus-dev/formhaus-swift"
      ]
    }
  ]
}
