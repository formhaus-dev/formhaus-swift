{
  "output": {
    "name": "formhaus-swift",
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "transition": 0.22,
    "poster": {
      "beat": "branch",
      "at": 2
    },
    "gif": {
      "width": 800,
      "fps": 15,
      "maxBytes": 3000000
    }
  },
  "theme": {
    "fonts": {
      "sans": "'Inter Variable', Inter, ui-sans-serif, system-ui, sans-serif",
      "mono": "ui-monospace, 'SF Mono', Menlo, Monaco, monospace"
    },
    "colors": {
      "background": "{color.bg.hover}",
      "surface": "{color.bg.default}",
      "text": "{color.text.default}",
      "muted": "{color.text.muted}",
      "border": "{color.border.default}",
      "primary": "{color.primary.default}",
      "primarySoft": "{color.primary.soft}",
      "error": "{color.error.default}",
      "ink": "#0d0d15",
      "lavender": "#e7d9fa",
      "bezel": "{palette.graphite.950}",
      "bezelEdge": "{palette.graphite.700}",
      "code": "{color.bg.default}",
      "codeText": "{color.text.default}",
      "codeMuted": "{color.text.muted}",
      "codeKey": "{color.primary.default}",
      "codeString": "#1f7a4d",
      "codeError": "{color.error.default}",
      "success": "#1f9d55"
    }
  },
  "devices": {
    "iphone": {
      "kind": "iphone",
      "simulator": "iPhone 17 Pro",
      "screen": [
        402,
        874
      ],
      "radius": 62,
      "contentSize": "extra-large"
    },
    "browser": {
      "kind": "browser",
      "viewport": [
        1280,
        800
      ],
      "scale": 1.5,
      "url": "northwind.studio/start",
      "pageZoom": 1
    },
    "mac": {
      "kind": "mac",
      "window": [
        1280,
        792
      ],
      "title": "Start a project"
    }
  },
  "edit": {
    "field": "brandLink",
    "property": "show.0.contains",
    "value": "design"
  },
  "marks": {
    "tour": {
      "first": 1.687,
      "error": 1.687,
      "landing": 4.026,
      "branch": 5.057,
      "back": 7
    },
    "showcase": {
      "first": 1.069,
      "condition": 1.069,
      "site": 1.732,
      "typing": 2.051,
      "project": 3.631,
      "scope": 4.26,
      "services": 5.173,
      "scoped": 5.484,
      "contact": 6.155,
      "server": 10.074,
      "success": 14.445,
      "end": 15.845
    },
    "styles": {
      "first": 7.41,
      "filled": 7.41,
      "system": 9.646,
      "brand": 13.107,
      "formhaus": 16.519,
      "end": 17.919
    },
    "branch": {
      "first": 1.135,
      "landing": 1.135,
      "branch": 1.813,
      "errors": 3.318,
      "typing": 4.253,
      "end": 5.653
    },
    "edit": {
      "first": 1.095,
      "picked": 1.095,
      "scope": 1.418,
      "design": 2.019,
      "end": 3.419
    }
  },
  "footage": {
    "ios-tour": {
      "device": "iphone",
      "script": "tour",
      "stop": "back",
      "definition": "base",
      "length": 8,
      "motion": false
    },
    "ios-showcase": {
      "device": "iphone",
      "script": "showcase",
      "definition": "base",
      "length": 27,
      "speed": 1.5
    },
    "ios-variant": {
      "device": "iphone",
      "script": "edit",
      "definition": "variant",
      "length": 9,
      "speed": 1.5
    },
    "ios-styles": {
      "device": "iphone",
      "script": "styles",
      "definition": "base",
      "length": 21,
      "motion": false
    },
    "mac-still": {
      "device": "mac",
      "definition": "base",
      "still": true
    },
    "web-tour": {
      "device": "browser",
      "script": "tour",
      "stop": "back",
      "definition": "base",
      "length": 7.6
    },
    "web-variant": {
      "device": "browser",
      "script": "edit",
      "definition": "variant",
      "length": 3.6,
      "speed": 1.5
    },
    "ios-branch": {
      "device": "iphone",
      "script": "branch",
      "definition": "base",
      "length": 9,
      "speed": 1.5
    },
    "web-branch": {
      "device": "browser",
      "script": "branch",
      "definition": "base",
      "length": 6.4,
      "speed": 1.5
    },
    "web-edit": {
      "device": "browser",
      "script": "edit",
      "definition": "base",
      "length": 3.6,
      "speed": 1.5
    },
    "ios-edit": {
      "device": "iphone",
      "script": "edit",
      "definition": "base",
      "length": 9,
      "speed": 1.5
    }
  },
  "beats": [
    {
      "id": "launch",
      "scene": "launch",
      "duration": 3,
      "title": "Formhaus on iOS and macOS",
      "subline": "Native SwiftUI, same JSON as the web",
      "file": "project-inquiry.json",
      "code": [
        "{",
        "  \"key\": \"projectType\",",
        "  \"type\": \"radio\",",
        "  \"label\": \"What do you need?\",",
        "  \"options\": [\"new-site\", \"redesign\", …]",
        "}"
      ],
      "timing": {
        "code": 0.75,
        "build": 0.9,
        "title": 1.3,
        "devices": 2.25
      }
    },
    {
      "id": "branch",
      "scene": "split",
      "duration": 1.9,
      "devices": {
        "web": "browser",
        "ios": "iphone"
      },
      "clips": {
        "web": "web-branch",
        "ios": "ios-branch"
      },
      "sync": {
        "web": [
          "branch",
          "landing"
        ],
        "ios": [
          "branch",
          "landing"
        ]
      },
      "from": -0.45,
      "cursor": true,
      "caption": "Same answer, same next step",
      "continues": true
    },
    {
      "id": "parity",
      "scene": "split",
      "duration": 2.6,
      "devices": {
        "web": "browser",
        "ios": "iphone"
      },
      "clips": {
        "web": "web-branch",
        "ios": "ios-branch"
      },
      "sync": {
        "web": [
          "branch",
          "errors"
        ],
        "ios": [
          "branch",
          "errors"
        ]
      },
      "from": -0.45,
      "cursor": true,
      "caption": "Same field errors and error summary"
    },
    {
      "id": "tour",
      "scene": "tour",
      "duration": 9.07,
      "device": "iphone",
      "clip": "ios-showcase",
      "script": "showcase",
      "title": "JSON forms rendered in SwiftUI",
      "segments": [
        {
          "from": "condition",
          "lead": 0.45,
          "length": 1.07,
          "rate": 1,
          "label": "Image choices"
        },
        {
          "from": "site",
          "lead": 0,
          "length": 2.15,
          "rate": 1,
          "label": "Conditional fields"
        },
        {
          "from": "scope",
          "lead": 0.402,
          "length": 2,
          "rate": 1,
          "label": "Checkboxes and ratings"
        },
        {
          "from": "server",
          "lead": 1.05,
          "length": 1.65,
          "rate": 1,
          "label": "Server errors on fields"
        },
        {
          "from": "success",
          "lead": 0.95,
          "length": 2,
          "rate": 1,
          "label": "Success"
        }
      ]
    },
    {
      "id": "looks",
      "scene": "looks",
      "duration": 3.6,
      "title": "Bring your own components",
      "clip": "ios-styles",
      "sets": [
        {
          "at": "filled",
          "offset": 0.6,
          "name": "Formhaus"
        },
        {
          "at": "system",
          "offset": 2.6,
          "name": "SwiftUI Form"
        },
        {
          "at": "brand",
          "offset": 1.2,
          "name": "Kiln"
        }
      ]
    },
    {
      "id": "proof",
      "scene": "proof",
      "duration": 2.4,
      "count": "shared conformance tests pass in TypeScript and Swift",
      "header": "Test",
      "engines": [
        "TypeScript",
        "Swift"
      ]
    },
    {
      "id": "end",
      "scene": "end",
      "duration": 3.2,
      "title": "Same JSON for web, iOS and macOS",
      "devices": [
        "browser",
        "mac",
        "iphone"
      ],
      "stills": {
        "browser": "web-tour",
        "mac": "mac-still",
        "iphone": "ios-tour"
      },
      "at": {
        "browser": 0.5,
        "iphone": 0.5
      },
      "install": ".package(url: \"https://github.com/formhaus-dev/formhaus-swift.git\", from: \"0.1.3\")",
      "links": [
        "formhaus.dev",
        "github.com/formhaus-dev/formhaus-swift"
      ]
    }
  ]
}
