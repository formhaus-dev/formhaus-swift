{
  "output": {
    "name": "formhaus-swift",
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "transition": 0.22,
    "poster": {
      "beat": "branch",
      "at": 2.0
    },
    "gif": {
      "width": 800,
      "fps": 15,
      "maxBytes": 3000000
    }
  },
  "theme": {
    "fonts": {
      "sans": "'Inter Variable', Inter, ui-sans-serif, system-ui, sans-serif",
      "mono": "ui-monospace, 'SF Mono', Menlo, Monaco, monospace"
    },
    "colors": {
      "background": "{color.bg.hover}",
      "surface": "{color.bg.default}",
      "text": "{color.text.default}",
      "muted": "{color.text.muted}",
      "border": "{color.border.default}",
      "primary": "{color.primary.default}",
      "primarySoft": "{color.primary.soft}",
      "error": "{color.error.default}",
      "ink": "#0d0d15",
      "lavender": "#e7d9fa",
      "bezel": "{palette.graphite.950}",
      "bezelEdge": "{palette.graphite.700}",
      "code": "{color.bg.default}",
      "codeText": "{color.text.default}",
      "codeMuted": "{color.text.muted}",
      "codeKey": "{color.primary.default}",
      "codeString": "#1f7a4d",
      "codeError": "{color.error.default}",
      "success": "#1f9d55"
    }
  },
  "devices": {
    "iphone": {
      "kind": "iphone",
      "simulator": "iPhone 17 Pro",
      "screen": [
        402,
        874
      ],
      "radius": 62,
      "contentSize": "extra-large"
    },
    "browser": {
      "kind": "browser",
      "viewport": [
        1280,
        800
      ],
      "scale": 1.5,
      "url": "northwind.studio/start",
      "pageZoom": 1.0
    },
    "mac": {
      "kind": "mac",
      "window": [
        1280,
        792
      ],
      "title": "Start a project"
    }
  },
  "edit": {
    "field": "brandLink",
    "property": "show.0.contains",
    "value": "design"
  },
  "marks": {
    "tour": {
      "first": 1.687,
      "error": 1.687,
      "landing": 4.026,
      "branch": 5.057,
      "back": 7.0
    },
    "showcase": {
      "first": 1.069,
      "condition": 1.069,
      "site": 1.693,
      "typing": 2.009,
      "project": 3.579,
      "scope": 4.245,
      "services": 5.178,
      "scoped": 5.481,
      "contact": 6.121,
      "server": 9.845,
      "success": 14.026,
      "end": 15.426
    },
    "styles": {
      "first": 7.31,
      "filled": 7.31,
      "system": 9.59,
      "brand": 13.013,
      "formhaus": 16.611,
      "end": 18.011
    },
    "branch": {
      "first": 1.077,
      "landing": 1.077,
      "branch": 1.757,
      "errors": 3.298,
      "typing": 4.224,
      "end": 5.624
    },
    "edit": {
      "first": 1.095,
      "picked": 1.095,
      "scope": 1.418,
      "design": 2.019,
      "end": 3.419
    }
  },
  "footage": {
    "ios-tour": {
      "device": "iphone",
      "script": "tour",
      "stop": "back",
      "definition": "base",
      "length": 8,
      "motion": false
    },
    "ios-showcase": {
      "device": "iphone",
      "script": "showcase",
      "definition": "base",
      "length": 27,
      "speed": 1.5
    },
    "ios-variant": {
      "device": "iphone",
      "script": "edit",
      "definition": "variant",
      "length": 9,
      "speed": 1.5
    },
    "ios-styles": {
      "device": "iphone",
      "script": "styles",
      "definition": "base",
      "length": 21,
      "motion": false
    },
    "mac-still": {
      "device": "mac",
      "definition": "base",
      "still": true
    },
    "web-tour": {
      "device": "browser",
      "script": "tour",
      "stop": "back",
      "definition": "base",
      "length": 7.6
    },
    "web-variant": {
      "device": "browser",
      "script": "edit",
      "definition": "variant",
      "length": 3.6,
      "speed": 1.5
    },
    "ios-branch": {
      "device": "iphone",
      "script": "branch",
      "definition": "base",
      "length": 9,
      "speed": 1.5
    },
    "web-branch": {
      "device": "browser",
      "script": "branch",
      "definition": "base",
      "length": 6.4,
      "speed": 1.5
    },
    "web-edit": {
      "device": "browser",
      "script": "edit",
      "definition": "base",
      "length": 3.6,
      "speed": 1.5
    },
    "ios-edit": {
      "device": "iphone",
      "script": "edit",
      "definition": "base",
      "length": 9,
      "speed": 1.5
    }
  },
  "beats": [
    {
      "id": "launch",
      "scene": "launch",
      "duration": 2.6,
      "title": "Formhaus is now on iOS and macOS",
      "subline": "Native SwiftUI, same JSON as the web",
      "devices": {
        "mac": "mac",
        "phone": "iphone"
      },
      "stills": {
        "mac": "mac-still",
        "phone": "ios-tour"
      },
      "at": 0.8
    },
    {
      "id": "branch",
      "scene": "split",
      "duration": 2.4,
      "devices": {
        "web": "browser",
        "ios": "iphone"
      },
      "clips": {
        "web": "web-branch",
        "ios": "ios-branch"
      },
      "sync": {
        "web": [
          "branch",
          "landing"
        ],
        "ios": [
          "branch",
          "landing"
        ]
      },
      "from": -0.45,
      "cursor": true,
      "caption": "Same rules on every platform"
    },
    {
      "id": "parity",
      "scene": "split",
      "duration": 2.6,
      "devices": {
        "web": "browser",
        "ios": "iphone"
      },
      "clips": {
        "web": "web-branch",
        "ios": "ios-branch"
      },
      "sync": {
        "web": [
          "branch",
          "errors"
        ],
        "ios": [
          "branch",
          "errors"
        ]
      },
      "from": -0.45,
      "cursor": true,
      "caption": "Same errors and branch handling on web and iOS"
    },
    {
      "id": "edit",
      "scene": "edit",
      "duration": 3.2,
      "devices": {
        "web": "browser",
        "ios": "iphone"
      },
      "clips": {
        "before": {
          "web": "web-edit",
          "ios": "ios-edit"
        },
        "after": {
          "web": "web-variant",
          "ios": "ios-variant"
        }
      },
      "title": "Fix it once and get it everywhere",
      "file": "project-inquiry.json",
      "cursor": true,
      "sync": [
        "edit",
        "design"
      ],
      "from": -0.4,
      "cuts": [
        0.9,
        1.9
      ]
    },
    {
      "id": "tour",
      "scene": "tour",
      "duration": 8.67,
      "device": "iphone",
      "clip": "ios-showcase",
      "script": "showcase",
      "title": "The formhaus components run natively on iOS",
      "segments": [
        {
          "from": "condition",
          "lead": 0.45,
          "length": 1.07,
          "rate": 1,
          "label": "Picture options"
        },
        {
          "from": "site",
          "lead": 0,
          "length": 2.15,
          "rate": 1,
          "label": "Conditions and typing"
        },
        {
          "from": "scope",
          "lead": 0.402,
          "length": 2.0,
          "rate": 1,
          "label": "Choices and scales"
        },
        {
          "from": "server",
          "lead": 1.05,
          "length": 1.65,
          "rate": 1,
          "label": "Server errors and focus"
        },
        {
          "from": "success",
          "lead": 1.1,
          "length": 1.6,
          "rate": 1,
          "label": "Success"
        }
      ]
    },
    {
      "id": "looks",
      "scene": "looks",
      "duration": 3.6,
      "title": "Bring your own components",
      "clip": "ios-styles",
      "sets": [
        {
          "at": "filled",
          "offset": 0.6,
          "name": "formhaus"
        },
        {
          "at": "system",
          "offset": 2.6,
          "name": "iOS system"
        },
        {
          "at": "brand",
          "offset": 1.2,
          "name": "Kiln"
        }
      ]
    },
    {
      "id": "proof",
      "scene": "proof",
      "duration": 2.4,
      "count": "shared conformance tests pass in TypeScript and Swift",
      "header": "Test",
      "engines": [
        "TypeScript",
        "Swift"
      ]
    },
    {
      "id": "end",
      "scene": "end",
      "duration": 3.2,
      "title": "Same engine for web, iOS and macOS",
      "devices": [
        "browser",
        "mac",
        "iphone"
      ],
      "stills": {
        "browser": "web-tour",
        "mac": "mac-still",
        "iphone": "ios-tour"
      },
      "at": {
        "browser": 0.5,
        "iphone": 0.5
      },
      "install": ".package(url: \"https://github.com/formhaus-dev/formhaus-swift.git\", from: \"0.1.3\")",
      "links": [
        "formhaus.dev",
        "github.com/formhaus-dev/formhaus-swift"
      ]
    }
  ]
}
